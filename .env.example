# Spotify App Remote SDK Integration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_REDIRECT_URI=roombeat://spotify-callback

# Web Landing Page & Deployment (Astro / Cloudflare)
SITE_URL=https://roombeat.app
