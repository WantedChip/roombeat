---
import RoomBeatIcon from './icons/RoomBeatIcon.astro';
import GithubIcon from './icons/GithubIcon.astro';
---

<footer class="border-t border-[#e0e2d3] bg-white py-16 text-[#35433a]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Top 4 Columns -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 pb-12 border-b border-[#e0e2d3]">
      <!-- Brand & Mission (Col 1-2) -->
      <div class="col-span-2">
        <div class="flex items-center gap-2.5">
          <RoomBeatIcon class="h-6 w-6" />
          <span class="font-sans text-lg font-bold text-[#062314]">RoomBeat</span>
          <span class="rounded-[2px] border border-[#e0e2d3] bg-[#fbfbf7] px-1.5 py-0.5 font-mono text-[10px] text-[#626b60]">
            FOSS
          </span>
        </div>
        <p class="mt-3 max-w-sm font-sans text-sm leading-relaxed text-[#626b60]">
          Perceptually-synchronized audio across a room full of phones on the same local network.
          Built with Kotlin, NDK C++, Oboe, and 20ms Opus frames.
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a
            href="https://github.com/WantedChip/RoomBeat"
            target="_blank"
            rel="noopener noreferrer"
            class="pill ghost !h-[28px] !px-2.5 font-mono text-xs border border-[#e0e2d3]"
          >
            <GithubIcon class="h-3.5 w-3.5" />
            <span>GitHub</span>
          </a>
          <span class="font-mono text-xs text-[#626b60]">MIT License</span>
        </div>
      </div>

      <!-- Column 1: Product -->
      <div>
        <h4 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#062314]">Product</h4>
        <ul class="mt-4 space-y-2.5 font-sans text-sm">
          <li><a href="/#features" class="hover:text-[#062314] transition-colors">Features</a></li>
          <li><a href="/#simulator" class="hover:text-[#062314] transition-colors">Sync Simulator</a></li>
          <li><a href="/#architecture" class="hover:text-[#062314] transition-colors">Architecture</a></li>
          <li><a href="/#compare" class="hover:text-[#062314] transition-colors">Side by Side</a></li>
          <li><a href="https://github.com/WantedChip/RoomBeat/releases/latest" class="hover:text-[#062314] transition-colors">Download APK</a></li>
        </ul>
      </div>

      <!-- Column 2: Developers -->
      <div>
        <h4 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#062314]">Developers</h4>
        <ul class="mt-4 space-y-2.5 font-sans text-sm">
          <li><a href="https://github.com/WantedChip/RoomBeat" target="_blank" class="hover:text-[#062314] transition-colors">GitHub Repository</a></li>
          <li><a href="https://github.com/WantedChip/RoomBeat/blob/main/CHANGELOG.md" target="_blank" class="hover:text-[#062314] transition-colors">Changelog</a></li>
          <li><a href="https://github.com/WantedChip/RoomBeat/blob/main/CONTRIBUTING.md" target="_blank" class="hover:text-[#062314] transition-colors">Contributing</a></li>
          <li><a href="https://github.com/WantedChip/RoomBeat/blob/main/SECURITY.md" target="_blank" class="hover:text-[#062314] transition-colors">Security Policy</a></li>
        </ul>
      </div>

      <!-- Column 3: Trust & Legal -->
      <div>
        <h4 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#062314]">Trust &amp; Legal</h4>
        <ul class="mt-4 space-y-2.5 font-sans text-sm">
          <li><a href="/privacy" class="hover:text-[#062314] transition-colors">Privacy Policy</a></li>
          <li><a href="/#trust" class="hover:text-[#062314] transition-colors">Zero Telemetry Audit</a></li>
          <li><a href="https://github.com/WantedChip/RoomBeat/blob/main/LICENSE" target="_blank" class="hover:text-[#062314] transition-colors">MIT License</a></li>
          <li><a href="/#faq" class="hover:text-[#062314] transition-colors">FAQ</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Status Bar (Graphify style) -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-[#626b60]">
      <!-- Status Badge -->
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#118d4f] opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#118d4f]"></span>
        </span>
        <span class="font-semibold text-[#062314]">ALL PROTOCOL SYSTEMS OPERATIONAL</span>
        <span class="text-[#e0e2d3]">|</span>
        <span>0.0 ms PHASE DRIFT</span>
      </div>

      <!-- Copyright -->
      <div>
        &copy; {new Date().getFullYear()} RoomBeat · Free &amp; Open Source Software
      </div>
    </div>
  </div>
</footer>
