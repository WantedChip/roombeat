---
import GithubIcon from './icons/GithubIcon.astro';
---

<section id="download" class="border-b border-[#e0e2d3] bg-[#fbfbf7] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="rounded-[4px] border border-[#e0e2d3] bg-white p-8 sm:p-14 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Left: Download & Overview -->
        <div class="lg:col-span-8">
          <div class="op-eyebrow">
            <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
            <span>GET ROOMBEAT v1.0.0</span>
          </div>

          <h2 class="op-title mt-3 text-3xl font-normal tracking-tight text-[#062314] sm:text-4xl md:text-5xl">
            Try RoomBeat now.
          </h2>

          <p class="op-sub mt-4 text-[#35433a]">
            Install the open-source Android APK on two or more phones, connect to the same Wi-Fi or hotspot,
            and create your first synchronized room in under 30 seconds.
          </p>

          <!-- Action buttons -->
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="https://github.com/WantedChip/RoomBeat/releases/latest"
              class="pill lg primary font-mono text-sm shadow-sm"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Download Android APK (v1.0.0)</span>
            </a>

            <a
              href="https://github.com/WantedChip/RoomBeat"
              target="_blank"
              rel="noopener noreferrer"
              class="pill lg ghost font-mono text-sm border border-[#e0e2d3]"
            >
              <GithubIcon class="h-4 w-4" />
              <span>Star on GitHub</span>
              <span class="text-[#626b60]">12.4k</span>
            </a>
          </div>

          <!-- Technical Verification Badges -->
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs text-[#626b60]">
            <span class="flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span> Android 11–17 (API 30–37)
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span> SHA-256 Verified Binary
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span> 0 Trackers · 0 Ads
            </span>
          </div>
        </div>

        <!-- Right: Mobile QR Join Card (Graphify style) -->
        <div class="lg:col-span-4 flex flex-col items-center justify-center rounded-[4px] border border-[#e0e2d3] bg-[#fbfbf7] p-6 text-center">
          <div class="font-mono text-xs font-semibold text-[#062314] uppercase tracking-wider">
            SCAN TO INSTALL ON PHONE
          </div>
          
          <!-- Mock QR Container -->
          <div class="mt-4 flex h-36 w-36 items-center justify-center rounded-[2px] border border-[#062314] bg-white p-2 shadow-sm">
            <svg class="h-full w-full" viewBox="0 0 100 100" fill="#062314">
              <!-- Corner markers -->
              <rect x="5" y="5" width="26" height="26" fill="#062314"/>
              <rect x="9" y="9" width="18" height="18" fill="white"/>
              <rect x="13" y="13" width="10" height="10" fill="#062314"/>
              
              <rect x="69" y="5" width="26" height="26" fill="#062314"/>
              <rect x="73" y="9" width="18" height="18" fill="white"/>
              <rect x="77" y="13" width="10" height="10" fill="#062314"/>

              <rect x="5" y="69" width="26" height="26" fill="#062314"/>
              <rect x="9" y="73" width="18" height="18" fill="white"/>
              <rect x="13" y="77" width="10" height="10" fill="#062314"/>

              <!-- Central QR data bits -->
              <rect x="36" y="10" width="8" height="8"/>
              <rect x="48" y="10" width="8" height="8"/>
              <rect x="40" y="24" width="8" height="8"/>
              <rect x="52" y="24" width="8" height="8"/>
              <rect x="10" y="36" width="8" height="8"/>
              <rect x="22" y="44" width="8" height="8"/>
              <rect x="36" y="36" width="12" height="12"/>
              <rect x="54" y="38" width="8" height="8"/>
              <rect x="70" y="36" width="8" height="8"/>
              <rect x="82" y="44" width="8" height="8"/>
              <rect x="38" y="54" width="8" height="8"/>
              <rect x="50" y="54" width="8" height="8"/>
              <rect x="36" y="68" width="8" height="8"/>
              <rect x="48" y="76" width="8" height="8"/>
              <rect x="68" y="68" width="12" height="12"/>
              <rect x="84" y="76" width="8" height="8"/>
            </svg>
          </div>

          <div class="mt-3 font-mono text-[11px] text-[#626b60]">
            Point camera to download APK directly
          </div>
          <div class="mt-2 font-mono text-xs font-bold text-[#062314]">
            roombeat-v1.0.0-release.apk
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
