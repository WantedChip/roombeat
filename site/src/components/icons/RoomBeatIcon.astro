---
export interface Props {
  class?: string;
}

const { class: className = 'w-5 h-5' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  class={className}
  aria-hidden="true"
>
  <rect x="2" y="2" width="20" height="20" rx="3" fill="#062314" />
  <circle cx="12" cy="12" r="4.5" fill="none" stroke="#ffffff" stroke-width="1.8" />
  <circle cx="12" cy="12" r="1.8" fill="#118d4f" />
  <path d="M12 4.5v1.5M12 18v1.5M4.5 12h1.5M18 12h1.5" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" />
</svg>
