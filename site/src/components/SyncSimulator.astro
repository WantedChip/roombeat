    const tempoReadout = document.getElementById('tempo-readout');

    const btnRandomJitter = document.getElementById('btn-random-jitter');
    const sliderJitter = document.getElementById('slider-jitter');
    const jitterReadoutBadge = document.getElementById('jitter-readout-badge');
    const btnEngageSync = document.getElementById('btn-engage-sync');
    const presetButtons = document.querySelectorAll('.btn-preset');

    const engineBeacon = document.getElementById('sim-engine-beacon');
    const engineDot = document.getElementById('sim-engine-dot');
    const engineText = document.getElementById('sim-engine-text');
    const syncBeacon = document.getElementById('sim-sync-beacon');
    const syncDot = document.getElementById('sim-sync-dot');
    const syncText = document.getElementById('sim-sync-text');
    const diagnosticText = document.getElementById('sim-diagnostic-text');

    const btnModeRadar = document.getElementById('btn-mode-radar');
    const btnModeLissajous = document.getElementById('btn-mode-lissajous');
    const scopeStatusLeft = document.getElementById('scope-status-left');

    const beamRect = document.getElementById('beam-rect');
    const dialArcOffset = document.getElementById('dial-arc-offset');
    const dialValOffset = document.getElementById('dial-val-offset');
    const dialArcLoss = document.getElementById('dial-arc-loss');
    const dialValLoss = document.getElementById('dial-val-loss');
    const dialArcBuffer = document.getElementById('dial-arc-buffer');
    const dialValBuffer = document.getElementById('dial-val-buffer');

    const channelStrips = document.querySelectorAll('.channel-strip');

    // 1. Play / Stop Toggle
    btnToggle?.addEventListener('click', async () => {
      simulator.playKeycapClick();
      await simulator.toggle();
      updateTransportUI();
    });

    function updateTransportUI() {
      if (simulator.isPlaying) {
        iconPlay?.classList.add('hidden');
        iconStop?.classList.remove('hidden');
        if (transportText) transportText.textContent = 'STOP RIG';
        
        // Update engine beacon
        engineBeacon?.classList.remove('text-text-dim');
        engineBeacon?.classList.add('text-sync-green', 'border-sync-green/30', 'bg-sync-green/10');
        engineDot?.classList.remove('bg-text-dim');
        engineDot?.classList.add('bg-sync-green', 'animate-status-blink');
        if (engineText) engineText.textContent = 'ENGINE: RUNNING';

        updateDiagnostic();
      } else {
        iconPlay?.classList.remove('hidden');
        iconStop?.classList.add('hidden');
        if (transportText) transportText.textContent = 'START MULTI-PHONE RIG';

        // Update engine beacon
        engineBeacon?.classList.remove('text-sync-green', 'border-sync-green/30', 'bg-sync-green/10');
        engineBeacon?.classList.add('text-text-dim');
        engineDot?.classList.remove('bg-sync-green', 'animate-status-blink');
        engineDot?.classList.add('bg-text-dim');
        if (engineText) engineText.textContent = 'ENGINE: IDLE';

        if (diagnosticText) {
          diagnosticText.textContent = '[ STANDBY ] Click "START MULTI-PHONE RIG" to initialize the WebAudio synthesizer.';
        }
      }
    }

    // 2. Tempo Stepper Controls
    btnTempoDown?.addEventListener('click', () => {
      simulator.playKeycapClick();
      const newBpm = simulator.setTempo(simulator.tempoBpm - 2);
      if (tempoReadout) tempoReadout.textContent = `${newBpm} BPM`;
    });

    btnTempoUp?.addEventListener('click', () => {
      simulator.playKeycapClick();
      const newBpm = simulator.setTempo(simulator.tempoBpm + 2);
      if (tempoReadout) tempoReadout.textContent = `${newBpm} BPM`;
    });

    // 3. Dual-Mode Visualizer Toggle
    btnModeRadar?.addEventListener('click', () => {
      simulator.playKeycapClick();
      radar.setMode('radar');
      btnModeRadar.className = 'mode-toggle-btn px-2.5 py-1 rounded-[4px] font-mono text-[11px] font-bold uppercase transition-all flex items-center gap-1.5 bg-surface-elevated text-sync-green border border-sync-green/30';
      btnModeRadar.querySelector('.mode-led')?.classList.replace('bg-text-dim', 'bg-sync-green');
      btnModeRadar.querySelector('.mode-led')?.classList.add('animate-status-blink');

      btnModeLissajous.className = 'mode-toggle-btn px-2.5 py-1 rounded-[4px] font-mono text-[11px] font-bold uppercase transition-all flex items-center gap-1.5 text-text-muted hover:text-bone';
      btnModeLissajous.querySelector('.mode-led')?.classList.replace('bg-sync-green', 'bg-text-dim');
      btnModeLissajous.querySelector('.mode-led')?.classList.remove('animate-status-blink');

      if (scopeStatusLeft) scopeStatusLeft.textContent = 'MODE: POLAR VECTOR RETICLE';
    });

    btnModeLissajous?.addEventListener('click', () => {
      simulator.playKeycapClick();
      radar.setMode('lissajous');
      btnModeLissajous.className = 'mode-toggle-btn px-2.5 py-1 rounded-[4px] font-mono text-[11px] font-bold uppercase transition-all flex items-center gap-1.5 bg-surface-elevated text-sync-green border border-sync-green/30';
      btnModeLissajous.querySelector('.mode-led')?.classList.replace('bg-text-dim', 'bg-sync-green');
      btnModeLissajous.querySelector('.mode-led')?.classList.add('animate-status-blink');

      btnModeRadar.className = 'mode-toggle-btn px-2.5 py-1 rounded-[4px] font-mono text-[11px] font-bold uppercase transition-all flex items-center gap-1.5 text-text-muted hover:text-bone';
      btnModeRadar.querySelector('.mode-led')?.classList.replace('bg-sync-green', 'bg-text-dim');
      btnModeRadar.querySelector('.mode-led')?.classList.remove('animate-status-blink');

      if (scopeStatusLeft) scopeStatusLeft.textContent = 'MODE: LISSAJOUS PHASE CORRELATION';
    });

    // 4. Wi-Fi Jitter Actions
    btnRandomJitter?.addEventListener('click', async () => {
      simulator.playKeycapClick();
      if (!simulator.isPlaying) {
        await simulator.start();
        updateTransportUI();
      }
      simulator.injectJitter();
      const avg = Math.round((simulator.channels[1].targetDelayMs + simulator.channels[2].targetDelayMs + simulator.channels[3].targetDelayMs) / 3);
      if (sliderJitter) sliderJitter.value = avg;
      updateSyncUI();
    });

    sliderJitter?.addEventListener('input', async (e) => {
      const val = parseFloat(e.target.value);
      if (val === 0) {
        simulator.engageSync();
      } else {
        if (!simulator.isPlaying) {
          await simulator.start();
          updateTransportUI();
        }
        simulator.injectJitter(val);
      }
      updateSyncUI();
    });

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        simulator.playKeycapClick();
        const preset = parseFloat(btn.dataset.jitterPreset);
        if (!simulator.isPlaying) {
          await simulator.start();
          updateTransportUI();
        }
        if (sliderJitter) sliderJitter.value = preset;
        simulator.injectJitter(preset);
        updateSyncUI();
      });
    });

    // 5. Engage RoomBeat Sync
    btnEngageSync?.addEventListener('click', () => {
      simulator.playKeycapClick();
      simulator.engageSync();
      if (sliderJitter) sliderJitter.value = 0;
      updateSyncUI();
    });

    function updateSyncUI() {
      const telemetry = simulator.getTelemetry();
      const isLocked = telemetry.isLocked;
      const maxDrift = telemetry.maxDriftMs;

      // Update Border Beam Color: Caution Amber when jittered, Phosphor Green when locked
      if (beamRect) {
        beamRect.setAttribute('stroke', isLocked ? '#00E599' : '#FFB800');
      }

      if (jitterReadoutBadge) {
        if (isLocked) {
          jitterReadoutBadge.textContent = '0.0 ms';
          jitterReadoutBadge.className = 'font-mono text-xs font-bold text-sync-green px-1.5 py-0.5 rounded bg-surface-recessed border border-border-milled tabular-nums';
        } else {
          jitterReadoutBadge.textContent = `+${maxDrift.toFixed(1)} ms`;
          jitterReadoutBadge.className = 'font-mono text-xs font-bold text-sync-amber px-1.5 py-0.5 rounded bg-surface-recessed border border-sync-amber/40 animate-pulse tabular-nums';
        }
      }

      if (syncBeacon && syncDot && syncText) {
        if (isLocked) {
          syncBeacon.className = 'px-2 py-0.5 rounded-[3px] bg-sync-green/10 border border-sync-green/30 text-sync-green flex items-center gap-1.5 transition-colors';
          syncDot.className = 'w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink';
          syncText.textContent = 'SYNC: LOCKED (<0.5ms)';
        } else {
          syncBeacon.className = 'px-2 py-0.5 rounded-[3px] bg-sync-amber/10 border border-sync-amber/30 text-sync-amber flex items-center gap-1.5 transition-colors';
          syncDot.className = 'w-1.5 h-1.5 rounded-full bg-sync-amber animate-pulse';
          syncText.textContent = `DRIFT: +${maxDrift.toFixed(1)}ms`;
        }
      }

      updateDiagnostic();
    }

    function updateDiagnostic() {
      if (!diagnosticText || !simulator.isPlaying) return;

      const isLocked = simulator.isLocked;
      if (isLocked) {
        diagnosticText.innerHTML = '<span class="text-sync-green font-bold">[ ACOUSTIC PHASE LOCKED ]</span> All 4 phone nodes playing in sub-0.5ms phase alignment. Sound is cohesive, transient attacks are crisp, and output power is summed.';
      } else {
        const drift = simulator.channels[2]?.delayMs || 25;
        diagnosticText.innerHTML = `<span class="text-sync-amber font-bold">[ COMB FILTERING ACTIVE: +${drift.toFixed(1)}ms DRIFT ]</span> Acoustic wave interference canceling frequencies across phone speakers. Notice the hollow timbre and flanging echo.`;
      }
    }

    // 6. Wire Precision Vertical Faders & Rocker Switches for all 4 Channels
    channelStrips.forEach((strip, chIndex) => {
      const faderContainer = strip.querySelector('.fader-track-container');
      const faderHandle = strip.querySelector('.fader-handle');
      const dbReadout = strip.querySelector('.ch-db-readout');
      const scaleTicks = strip.querySelectorAll('.fader-scale span');
      const btnMute = strip.querySelector('.btn-mute');
      const btnSolo = strip.querySelector('.btn-solo');

      // Click or drag on fader container
      let isDragging = false;

      function updateFaderFromPointer(e) {
        if (!faderContainer) return;
        const rect = faderContainer.getBoundingClientRect();
        const offsetY = rect.bottom - e.clientY;
        let pct = Math.round((offsetY / rect.height) * 100);
        pct = Math.max(0, Math.min(100, pct));
        
        // Magnetic center detent at 0 dB (pos 75)
        if (pct >= 72 && pct <= 78) {
          pct = 75;
        }

        const res = simulator.setChannelVolume(chIndex, pct);
        if (faderHandle) {
          faderHandle.style.bottom = `${res.faderPos}%`;
          faderHandle.setAttribute('aria-valuenow', res.faderPos.toString());
        }
        if (dbReadout) {
          dbReadout.textContent = res.dbText;
        }
      }

      faderContainer?.addEventListener('pointerdown', (e) => {
        isDragging = true;
        faderContainer.setPointerCapture(e.pointerId);
        faderHandle?.classList.add('is-dragging');
        simulator.playKeycapClick();
        updateFaderFromPointer(e);
      });

      faderContainer?.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        updateFaderFromPointer(e);
      });

      const stopDrag = (e) => {
        if (!isDragging) return;
        isDragging = false;
        faderHandle?.classList.remove('is-dragging');
        try {
          faderContainer.releasePointerCapture(e.pointerId);
        } catch {}
      };

      faderContainer?.addEventListener('pointerup', stopDrag);
      faderContainer?.addEventListener('pointercancel', stopDrag);

      // Keyboard Accessibility on Fader Handle
      faderHandle?.addEventListener('keydown', (e) => {
        const ch = simulator.channels[chIndex];
        let newPos = ch.faderPos;
        if (e.key === 'ArrowUp' || e.key === 'ArrowRight') {
          newPos = Math.min(100, newPos + 5);
        } else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') {
          newPos = Math.max(0, newPos - 5);
        } else if (e.key === 'PageUp') {
          newPos = Math.min(100, newPos + 25);
        } else if (e.key === 'PageDown') {
          newPos = Math.max(0, newPos - 25);
        } else {
          return;
        }
        e.preventDefault();
        simulator.playKeycapClick();
        const res = simulator.setChannelVolume(chIndex, newPos);
        faderHandle.style.bottom = `${res.faderPos}%`;
        faderHandle.setAttribute('aria-valuenow', res.faderPos.toString());
        if (dbReadout) dbReadout.textContent = res.dbText;
      });

      // Quick Snap by clicking dB tick marks
      scaleTicks.forEach((tick) => {
        tick.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetPos = parseInt(tick.dataset.targetPos, 10);
          simulator.playKeycapClick();
          const res = simulator.setChannelVolume(chIndex, targetPos);
          if (faderHandle) {
            faderHandle.style.bottom = `${res.faderPos}%`;
            faderHandle.setAttribute('aria-valuenow', res.faderPos.toString());
          }
          if (dbReadout) dbReadout.textContent = res.dbText;
        });
      });

      // Tactile Rocker Switches (Mute & Solo)
      btnMute?.addEventListener('click', () => {
        simulator.playKeycapClick();
        const isMuted = simulator.toggleMute(chIndex);
        const ledDot = btnMute.querySelector('.led-dot');

        if (isMuted) {
          btnMute.classList.add('bg-sync-red/20', 'border-sync-red/50', 'text-sync-red');
          btnMute.classList.remove('text-text-muted');
          ledDot?.classList.add('bg-sync-red', 'shadow-[0_0_6px_#FF334B]');
          ledDot?.classList.remove('bg-border-milled');
        } else {
          btnMute.classList.remove('bg-sync-red/20', 'border-sync-red/50', 'text-sync-red');
          btnMute.classList.add('text-text-muted');
          ledDot?.classList.remove('bg-sync-red', 'shadow-[0_0_6px_#FF334B]');
          ledDot?.classList.add('bg-border-milled');
        }
      });

      btnSolo?.addEventListener('click', () => {
        simulator.playKeycapClick();
        const isSolo = simulator.toggleSolo(chIndex);
        const ledDot = btnSolo.querySelector('.led-dot');

        if (isSolo) {
          btnSolo.classList.add('bg-sync-green/20', 'border-sync-green/50', 'text-sync-green');
          btnSolo.classList.remove('text-text-muted');
          ledDot?.classList.add('bg-sync-green', 'shadow-[0_0_6px_#00E599]');
          ledDot?.classList.remove('bg-border-milled');
        } else {
          btnSolo.classList.remove('bg-sync-green/20', 'border-sync-green/50', 'text-sync-green');
          btnSolo.classList.add('text-text-muted');
          ledDot?.classList.remove('bg-sync-green', 'shadow-[0_0_6px_#00E599]');
          ledDot?.classList.add('bg-border-milled');
        }
      });
    });

    // 7. High-Speed Telemetry Poller for UI Badges, Meters & Dials (60fps)
    const arcTotalLen = 108.9;

    function telemetryLoop() {
      requestAnimationFrame(telemetryLoop);

      if (!simulator) return;
      const tel = simulator.getTelemetry();

      // Step sequencer LED updates
      if (transportStepBadge) {
        transportStepBadge.textContent = tel.isPlaying
          ? `STEP: ${(tel.currentStep + 1).toString().padStart(2, '0')}/16`
          : 'STEP: 01/16';
      }

      for (let i = 0; i < 16; i++) {
        const led = document.getElementById(`step-led-${i}`);
        if (!led) continue;
        if (tel.isPlaying && i === tel.currentStep) {
          led.className = 'step-led h-full rounded-[1px] bg-signal-orange border-signal-orange shadow-[0_0_6px_#FF5500] transition-all duration-75';
        } else if (i % 4 === 0) {
          led.className = 'step-led h-full rounded-[1px] bg-surface-elevated border-border-active transition-all duration-75';
        } else {
          led.className = 'step-led h-full rounded-[1px] bg-surface-recessed border-border-milled transition-all duration-75';
        }
      }

      // Sync Beacon & Perimeter Border Beam updates
      const isLocked = tel.isLocked;
      const maxDrift = tel.maxDriftMs;

      if (beamRect) {
        beamRect.setAttribute('stroke', isLocked ? '#00E599' : '#FFB800');
      }

      if (jitterReadoutBadge) {
        if (isLocked) {
          jitterReadoutBadge.textContent = '0.0 ms';
          jitterReadoutBadge.className = 'font-mono text-xs font-bold text-sync-green px-1.5 py-0.5 rounded bg-surface-recessed border border-border-milled tabular-nums';
        } else {
          jitterReadoutBadge.textContent = `+${maxDrift.toFixed(1)} ms`;
          jitterReadoutBadge.className = 'font-mono text-xs font-bold text-sync-amber px-1.5 py-0.5 rounded bg-surface-recessed border border-sync-amber/40 animate-pulse tabular-nums';
        }
      }

      if (syncBeacon && syncDot && syncText) {
        if (isLocked) {
          syncBeacon.className = 'px-2 py-0.5 rounded-[3px] bg-sync-green/10 border border-sync-green/30 text-sync-green flex items-center gap-1.5 transition-colors';
          syncDot.className = 'w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink';
          syncText.textContent = 'SYNC: LOCKED (<0.5ms)';
        } else {
          syncBeacon.className = 'px-2 py-0.5 rounded-[3px] bg-sync-amber/10 border border-sync-amber/30 text-sync-amber flex items-center gap-1.5 transition-colors';
          syncDot.className = 'w-1.5 h-1.5 rounded-full bg-sync-amber animate-pulse';
          syncText.textContent = `DRIFT: +${maxDrift.toFixed(1)}ms`;
        }
      }

      // Bay 04 Telemetry Dials Update
      // Dial 1: Latency Offset (0..40ms)
      if (dialArcOffset && dialValOffset) {
        const offsetP = Math.min(1.0, maxDrift / 40.0);
        const offsetDash = arcTotalLen * (1 - offsetP);
        dialArcOffset.style.strokeDashoffset = offsetDash.toFixed(1);
        dialValOffset.textContent = isLocked ? '0.0ms' : `+${maxDrift.toFixed(1)}ms`;

        if (isLocked) {
          dialArcOffset.setAttribute('stroke', '#00E599');
          dialValOffset.className = 'font-mono text-[11px] font-bold text-sync-green tabular-nums';
        } else if (maxDrift > 25) {
          dialArcOffset.setAttribute('stroke', '#FF334B');
          dialValOffset.className = 'font-mono text-[11px] font-bold text-sync-red tabular-nums';
        } else {
          dialArcOffset.setAttribute('stroke', '#FFB800');
          dialValOffset.className = 'font-mono text-[11px] font-bold text-sync-amber tabular-nums';
        }
      }

      // Dial 2: Packet Loss % (0..10%)
      if (dialArcLoss && dialValLoss) {
        const lossPct = tel.packetLossPct;
        const lossP = Math.min(1.0, lossPct / 10.0);
        const lossDash = arcTotalLen * (1 - lossP);
        dialArcLoss.style.strokeDashoffset = lossDash.toFixed(1);
        dialValLoss.textContent = `${lossPct.toFixed(1)}%`;

        if (lossPct === 0) {
          dialArcLoss.setAttribute('stroke', '#00E599');
          dialValLoss.className = 'font-mono text-[11px] font-bold text-sync-green tabular-nums';
        } else if (lossPct > 4) {
          dialArcLoss.setAttribute('stroke', '#FF334B');
          dialValLoss.className = 'font-mono text-[11px] font-bold text-sync-red tabular-nums';
        } else {
          dialArcLoss.setAttribute('stroke', '#FFB800');
          dialValLoss.className = 'font-mono text-[11px] font-bold text-sync-amber tabular-nums';
        }
      }

      // Dial 3: Buffer Depth (10..60ms, nominal 20ms)
      if (dialArcBuffer && dialValBuffer) {
        const bufDepth = tel.bufferDepthMs;
        const bufP = Math.min(1.0, (bufDepth - 10) / 50.0);
        const bufDash = arcTotalLen * (1 - bufP);
        dialArcBuffer.style.strokeDashoffset = bufDash.toFixed(1);
        dialValBuffer.textContent = `${bufDepth}ms`;

        if (bufDepth <= 22) {
          dialArcBuffer.setAttribute('stroke', '#00E599');
          dialValBuffer.className = 'font-mono text-[11px] font-bold text-sync-green tabular-nums';
        } else {
          dialArcBuffer.setAttribute('stroke', '#FFB800');
          dialValBuffer.className = 'font-mono text-[11px] font-bold text-sync-amber tabular-nums';
        }
      }

      // Update Channel VU Meters & Delay Readouts
      channelStrips.forEach((strip, idx) => {
        const ch = tel.channels[idx];
        if (!ch) return;

        // Delay badge update
        const delayBadge = strip.querySelector('.ch-delay-badge');
        if (delayBadge) {
          if (idx === 0) {
            delayBadge.textContent = '0.0 ms [REF]';
            delayBadge.className = 'ch-delay-badge font-mono text-xs font-bold text-sync-green tabular-nums';
          } else if (ch.delayMs < 0.5) {
            delayBadge.textContent = '0.0 ms';
            delayBadge.className = 'ch-delay-badge font-mono text-xs font-bold text-sync-green tabular-nums';
          } else {
            delayBadge.textContent = `+${ch.delayMs.toFixed(1)} ms`;
            delayBadge.className = 'ch-delay-badge font-mono text-xs font-bold text-sync-amber tabular-nums';
          }
        }

        // Vertical VU meter fill
        const vuFill = strip.querySelector('.ch-vu-fill');
        if (vuFill) {
          if (!tel.isPlaying || ch.muted) {
            vuFill.style.height = '0%';
          } else {
            const rmsNormalized = Math.min(1.0, ch.rms * 3.5);
            const pct = Math.round(rmsNormalized * 100);
            vuFill.style.height = `${pct}%`;

            if (pct > 85) {
              vuFill.className = 'ch-vu-fill w-full bg-sync-red rounded-[1px] transition-all duration-75';
            } else if (pct > 65) {
              vuFill.className = 'ch-vu-fill w-full bg-sync-amber rounded-[1px] transition-all duration-75';
            } else {
              vuFill.className = 'ch-vu-fill w-full bg-sync-green rounded-[1px] transition-all duration-75';
            }
          }
        }
      });
    }

    requestAnimationFrame(telemetryLoop);
  }

  // Mount on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSimulatorIsland);
  } else {
    initSimulatorIsland();
  }
</script>
