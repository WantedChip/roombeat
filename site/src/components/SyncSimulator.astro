---
import {
  Play,
  Square,
  Activity,
  Zap,
  Radio,
  Sliders,
  CheckCircle2,
  AlertTriangle,
  RefreshCw,
} from 'lucide-astro';
---

<section
  id="sync-simulator"
  class="relative py-16 md:py-24 border-t border-border-milled bg-chassis-base overflow-hidden"
  aria-labelledby="simulator-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Stencil -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[4px] bg-surface-panel border border-border-milled mb-3">
          <span class="w-2 h-2 rounded-full bg-sync-green animate-status-blink"></span>
          <span class="font-mono text-xs font-semibold tracking-wider uppercase text-sync-green">
            Modular Soundboard Bento Rack
          </span>
          <span class="text-text-dim text-xs font-mono">•</span>
          <span class="font-mono text-xs text-text-muted">Pure WebAudio &amp; Dual-Mode Scope</span>
        </div>
        <h2
          id="simulator-heading"
          class="font-display font-extrabold text-3xl sm:text-4xl lg:text-[42px] leading-tight tracking-tight text-bone"
        >
          Simulate 4 Phones in Acoustic Sync.
        </h2>
      </div>
      <p class="font-sans text-sm sm:text-base text-text-muted max-w-lg leading-relaxed">
        Experience real acoustic comb filtering caused by Wi-Fi packet jitter, then engage
        RoomBeat’s NDK fractional resampler to witness sub-0.5ms phase-lock convergence.
      </p>
    </div>

    <!-- Main Industrial Soundboard Chassis with Magic UI Perimeter Scanning Border Beam -->
    <div
      id="soundboard-console"
      class="hardware-panel rounded-[10px] p-4 sm:p-6 lg:p-7 top-edge-lighting relative border border-border-milled bg-surface-panel overflow-hidden"
    >
      <!-- Magic UI Perimeter Scanning Border Beam -->
      <div id="soundboard-border-beam" class="pointer-events-none absolute inset-0 rounded-[10px] overflow-hidden z-10">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <filter id="beam-glow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="1.2" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>
          <rect
            id="beam-rect"
            x="0.4"
            y="0.4"
            width="99.2"
            height="99.2"
            rx="2.5"
            fill="none"
            stroke="#00E599"
            stroke-width="1.8"
            vector-effect="non-scaling-stroke"
            pathLength="100"
            stroke-dasharray="14 86"
            stroke-dashoffset="0"
            filter="url(#beam-glow)"
            class="animate-border-beam transition-colors duration-300"
          />
        </svg>
      </div>

      <!-- Main Chassis Corner Machined Allen Hex Bolts -->
      <div class="absolute top-2.5 left-2.5 pointer-events-none z-20">
        <svg class="allen-hex-bolt w-3.5 h-3.5 text-border-milled/90" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
          <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
        </svg>
      </div>
      <div class="absolute top-2.5 right-2.5 pointer-events-none z-20">
        <svg class="allen-hex-bolt w-3.5 h-3.5 text-border-milled/90" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
          <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
        </svg>
      </div>
      <div class="absolute bottom-2.5 left-2.5 pointer-events-none z-20">
        <svg class="allen-hex-bolt w-3.5 h-3.5 text-border-milled/90" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
          <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
        </svg>
      </div>
      <div class="absolute bottom-2.5 right-2.5 pointer-events-none z-20">
        <svg class="allen-hex-bolt w-3.5 h-3.5 text-border-milled/90" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
          <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
        </svg>
      </div>

      <!-- Master Rack Top Status Beacon Strip -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-6 border-b border-border-milled relative z-10">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-[2px] bg-signal-orange"></span>
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-bone">
            RACK MODULE: M-02 // 4-CHANNEL MODULAR ACOUSTIC CONSOLE
          </span>
        </div>

        <!-- Telemetry Status Beacons -->
        <div class="flex flex-wrap items-center gap-2 font-mono text-[11px]">
          <span
            id="sim-engine-beacon"
            class="px-2 py-0.5 rounded-[3px] bg-surface-recessed border border-border-milled text-text-dim flex items-center gap-1.5 transition-colors"
          >
            <span id="sim-engine-dot" class="w-1.5 h-1.5 rounded-full bg-text-dim"></span>
            <span id="sim-engine-text">ENGINE: IDLE</span>
          </span>

          <span class="hidden sm:inline-block px-2 py-0.5 rounded-[3px] bg-surface-recessed border border-border-milled text-text-muted">
            CLOCK: 48,000 HZ
          </span>

          <span class="hidden md:inline-block px-2 py-0.5 rounded-[3px] bg-surface-recessed border border-border-milled text-text-muted">
            CODEC: 20ms OPUS
          </span>

          <span
            id="sim-sync-beacon"
            class="px-2 py-0.5 rounded-[3px] bg-sync-green/10 border border-sync-green/30 text-sync-green flex items-center gap-1.5 transition-colors"
          >
            <span id="sim-sync-dot" class="w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink"></span>
            <span id="sim-sync-text">SYNC: LOCKED (&lt;0.5ms)</span>
          </span>
        </div>
      </div>

      <!-- ========================================================================= -->
      <!-- ACETERNITY BENTO GRID RACK BAYS                                            -->
      <!-- ========================================================================= -->

      <!-- UPPER DECK: BAY 02 (Visualizer) + BAY 01 (Clock Generator) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 mb-6 relative z-10">
        
        <!-- ======================================================================= -->
        <!-- BAY 02: DUAL-MODE VISUALIZER (Polar Radar vs Lissajous Oscilloscope)   -->
        <!-- ======================================================================= -->
        <div class="lg:col-span-7 hardware-card rounded-[8px] p-4 border border-border-milled top-edge-lighting relative flex flex-col justify-between" id="bay-02">
          <!-- Corner Allen Hex Bolts -->
          <div class="absolute top-2 left-2 pointer-events-none">
            <svg class="allen-hex-bolt w-2.5 h-2.5 text-border-milled/70" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
              <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
            </svg>
          </div>
          <div class="absolute top-2 right-2 pointer-events-none">
            <svg class="allen-hex-bolt w-2.5 h-2.5 text-border-milled/70" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
              <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
            </svg>
          </div>

          <!-- Bay Header & Dual-Mode Toggle Button Group -->
          <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-2 border-b border-border-milled/70">
            <div class="flex items-center gap-2 pl-4">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-text-muted">
                BAY 02 // DUAL-MODE PHASE OSCILLOSCOPE
              </span>
            </div>

            <!-- Mode Switcher -->
            <div class="flex items-center gap-1 bg-surface-recessed p-1 rounded-[6px] border border-border-milled">
              <button
                id="btn-mode-radar"
                type="button"
                class="mode-toggle-btn px-2.5 py-1 rounded-[4px] font-mono text-[11px] font-bold uppercase transition-all flex items-center gap-1.5 bg-surface-elevated text-sync-green border border-sync-green/30"
                data-mode="radar"
                aria-label="Switch to Polar Phase Radar Mode"
              >
                <span class="mode-led w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink"></span>
                <span>POLAR RADAR</span>
              </button>
              <button
                id="btn-mode-lissajous"
                type="button"
                class="mode-toggle-btn px-2.5 py-1 rounded-[4px] font-mono text-[11px] font-bold uppercase transition-all flex items-center gap-1.5 text-text-muted hover:text-bone"
                data-mode="lissajous"
                aria-label="Switch to Lissajous Phase Scope Mode"
              >
                <span class="mode-led w-1.5 h-1.5 rounded-full bg-text-dim"></span>
                <span>LISSAJOUS SCOPE</span>
              </button>
            </div>
          </div>

          <!-- Recessed Oscilloscope Screen Cavity -->
          <div class="recessed-cavity rounded-[8px] p-2 flex-1 flex flex-col justify-center min-h-[300px] sm:min-h-[340px] relative">
            <canvas
              id="radar-canvas"
              class="w-full h-full min-h-[280px] sm:min-h-[320px] rounded-[4px] block cursor-crosshair"
              aria-label="Dual-Mode Acoustic Phase Radar and Lissajous Scope"
            ></canvas>
          </div>

          <!-- Visualizer Bottom Status Readout -->
          <div class="flex items-center justify-between font-mono text-[10px] text-text-dim pt-2 px-1">
            <span id="scope-status-left">MODE: POLAR VECTOR RETICLE</span>
            <span id="scope-status-right" class="text-sync-green">REF: HOST CLOCK_MONOTONIC</span>
          </div>
        </div>

        <!-- ======================================================================= -->
        <!-- BAY 01: MASTER CLOCK GENERATOR (Transport, Tempo, Step, Sync Trigger)  -->
        <!-- ======================================================================= -->
        <div class="lg:col-span-5 hardware-card rounded-[8px] p-4 border border-border-milled top-edge-lighting relative flex flex-col justify-between space-y-4" id="bay-01">
          <!-- Corner Allen Hex Bolts -->
          <div class="absolute top-2 left-2 pointer-events-none">
            <svg class="allen-hex-bolt w-2.5 h-2.5 text-border-milled/70" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
              <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
            </svg>
          </div>
          <div class="absolute top-2 right-2 pointer-events-none">
            <svg class="allen-hex-bolt w-2.5 h-2.5 text-border-milled/70" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
              <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
            </svg>
          </div>

          <!-- Bay Header -->
          <div class="flex items-center justify-between pb-2 border-b border-border-milled/70 pl-4">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-text-muted">
              BAY 01 // MASTER CLOCK GENERATOR
            </span>
            <span class="font-mono text-[10px] text-text-dim">HOST TX</span>
          </div>

          <!-- 1. Master Play/Stop Keycap Trigger -->
          <div>
            <button
              id="btn-toggle-playback"
              type="button"
              class="w-full tactile-keycap-btn py-3.5 px-4 flex items-center justify-center gap-2.5 text-sm uppercase tracking-wider font-display font-bold text-[#0B0C0E]"
              aria-label="Start or Stop Multi-Phone Rig Playback"
            >
              <div class="keycap-inner flex items-center justify-center gap-2">
                <Play id="icon-play" class="w-4 h-4 fill-current stroke-[2.5]" />
                <Square id="icon-stop" class="w-4 h-4 fill-current stroke-[2.5] hidden" />
                <span id="transport-btn-text">START MULTI-PHONE RIG</span>
              </div>
            </button>
            <p class="font-mono text-[10px] text-text-dim mt-1.5 text-center">
              Synthesizes 4-channel synchronized groove (Kick, Snare, Bass, Stabs)
            </p>
          </div>

          <!-- 2. Master Tempo BPM Stepper -->
          <div class="flex items-center justify-between gap-2 p-2 rounded-[6px] bg-surface-recessed border border-border-milled">
            <div class="flex items-center gap-2">
              <Activity class="w-3.5 h-3.5 text-signal-orange" />
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-text-muted">TEMPO</span>
            </div>
            <div class="flex items-center gap-1.5">
              <button
                id="btn-tempo-down"
                type="button"
                class="tactile-btn-secondary w-7 h-7 flex items-center justify-center font-mono text-xs font-bold text-bone hover:border-signal-orange transition-colors"
                aria-label="Decrease Master Tempo"
              >
                -
              </button>
              <span id="tempo-readout" class="font-mono text-xs font-bold text-bone w-16 text-center tabular-nums">
                124 BPM
              </span>
              <button
                id="btn-tempo-up"
                type="button"
                class="tactile-btn-secondary w-7 h-7 flex items-center justify-center font-mono text-xs font-bold text-bone hover:border-signal-orange transition-colors"
                aria-label="Increase Master Tempo"
              >
                +
              </button>
            </div>
          </div>

          <!-- 3. 16-Step Sequencer LED Bar -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between font-mono text-[10px] text-text-dim">
              <span>16-STEP MASTER CLOCK</span>
              <span id="transport-step-badge" class="text-signal-orange font-bold tabular-nums">STEP: 01/16</span>
            </div>
            <div id="step-sequencer-grid" class="grid grid-cols-16 gap-1 h-2.5">
              {Array.from({ length: 16 }).map((_, i) => (
                <div
                  id={`step-led-${i}`}
                  class={`step-led h-full rounded-[1px] border border-border-milled transition-all duration-75 ${
                    i % 4 === 0 ? 'bg-surface-elevated' : 'bg-surface-recessed'
                  }`}
                  data-step-index={i}
                ></div>
              ))}
            </div>
          </div>

          <!-- 4. RoomBeat Phase-Lock Trigger -->
          <div class="pt-2 border-t border-border-milled/70">
            <button
              id="btn-engage-sync"
              type="button"
              class="w-full tactile-btn-primary bg-[#00E599] hover:bg-[#00FFAA] text-[#0B0C0E] border-[#33FFBB] py-3 px-4 flex items-center justify-center gap-2 text-sm uppercase tracking-wider font-display font-bold shadow-[0_2px_12px_rgba(0,229,153,0.3)] transition-all"
            >
              <Zap class="w-4 h-4 fill-current stroke-[2.5]" />
              <span>ENGAGE ROOMBEAT SYNC</span>
            </button>
            <p class="font-mono text-[10px] text-text-dim mt-1.5 text-center">
              NDK Catmull-Rom resampler slews drift to 0.0ms without pitch jumps
            </p>
          </div>
        </div>

      </div>

      <!-- LOWER DECK: BAY 03 (4-Channel Strip Mixer) + BAY 04 (Jitter Diagnostic Bay) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 relative z-10">
        
        <!-- ======================================================================= -->
        <!-- BAY 03: 4-CHANNEL STRIP MIXER (Origin UI Precision Faders & Switches)   -->
        <!-- ======================================================================= -->
        <div class="lg:col-span-8 hardware-card rounded-[8px] p-4 border border-border-milled top-edge-lighting relative flex flex-col justify-between" id="bay-03">
          <!-- Corner Allen Hex Bolts -->
          <div class="absolute top-2 left-2 pointer-events-none">
            <svg class="allen-hex-bolt w-2.5 h-2.5 text-border-milled/70" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
              <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
            </svg>
          </div>
          <div class="absolute top-2 right-2 pointer-events-none">
            <svg class="allen-hex-bolt w-2.5 h-2.5 text-border-milled/70" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="#13151A" />
              <polygon points="8,4.5 11,6.2 11,9.8 8,11.5 5,9.8 5,6.2" stroke="#3E4454" stroke-width="1" fill="#07080A" />
            </svg>
          </div>

          <!-- Bay Header -->
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-border-milled/70 pl-4">
            <div>
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-text-muted">
                BAY 03 // 4-CHANNEL STRIP MIXER
              </span>
              <span class="hidden sm:inline font-mono text-[10px] text-text-dim ml-2">
                ORIGIN UI PRECISION VERTICAL FADERS &amp; ROCKER SWITCHES
              </span>
            </div>
            <span class="font-mono text-[10px] text-sync-green">SUMMED 0dB CEILING</span>
          </div>

          <!-- 4 Phone Channel Strips Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3.5">
            
            <!-- Channel 01: Host -->
            <div class="channel-strip bg-surface-elevated rounded-[6px] p-3 border border-border-milled flex flex-col justify-between relative" data-channel="0">
              <!-- Channel Header -->
              <div class="mb-2">
                <div class="flex items-center justify-between gap-1 mb-1">
                  <span class="font-mono text-[10px] font-bold text-signal-orange bg-signal-orange/10 border border-signal-orange/30 px-1.5 py-0.5 rounded-[3px]">
                    CH 01 // HOST
                  </span>
                  <span class="ch-delay-badge font-mono text-xs font-bold text-sync-green tabular-nums">
                    0.0 ms [REF]
                  </span>
                </div>
                <div class="font-sans font-semibold text-xs text-bone truncate">Pixel 8 Pro</div>
                <div class="font-mono text-[9px] text-text-dim">Master Clock Reference</div>
              </div>

              <!-- Precision Vertical Fader & VU Meter Assembly -->
              <div class="channel-fader-assembly flex items-center justify-between gap-2 py-2">
                <!-- Numeric dB scale tick marks -->
                <div class="fader-scale flex flex-col justify-between h-[150px] text-[9px] font-mono text-text-dim select-none pr-1 text-right">
                  <span class="hover:text-text-muted cursor-pointer" data-target-pos="100">+3dB</span>
                  <span class="text-bone font-bold cursor-pointer" data-target-pos="75">0dB</span>
                  <span class="hover:text-text-muted cursor-pointer" data-target-pos="50">-6dB</span>
                  <span class="hover:text-text-muted cursor-pointer" data-target-pos="25">-12dB</span>
                  <span class="hover:text-text-muted cursor-pointer" data-target-pos="0">-inf</span>
                </div>

                <!-- Vertical Fader Track Container -->
                <div
                  class="fader-track-container relative h-[150px] w-12 flex items-center justify-center select-none cursor-pointer"
                  data-channel-index="0"
                >
                  <!-- Recessed Slot -->
                  <div class="w-2.5 h-full fader-track-recessed rounded-[3px] relative pointer-events-none">
                    <!-- 0dB Magnetic Detent Marker Notch -->
                    <div class="absolute left-[-4px] right-[-4px] top-[25%] h-[2px] bg-sync-green/80 rounded-[1px]"></div>
                  </div>
                  <!-- Sliding Metallic Handle (Fader Cap) -->
                  <div
                    class="fader-handle absolute fader-cap-metallic w-10 h-5 rounded-[3px] cursor-grab active:cursor-grabbing flex flex-col items-center justify-center z-10"
                    style="bottom: 75%; transform: translateY(50%);"
                    role="slider"
                    aria-label="Channel 1 Volume Fader"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="75"
                    tabindex="0"
                  >
                    <div class="w-full h-[2px] bg-bone pointer-events-none"></div>
                    <div class="flex gap-0.5 mt-0.5 pointer-events-none">
                      <span class="w-2.5 h-[1px] bg-text-dim"></span>
                      <span class="w-2.5 h-[1px] bg-text-dim"></span>
                    </div>
                  </div>
                </div>

                <!-- Vertical High-Resolution VU Peak Meter -->
                <div class="flex flex-col items-center h-[150px] w-3">
                  <div class="w-2.5 h-full bg-surface-recessed border border-border-milled rounded-[2px] p-[1px] relative overflow-hidden flex flex-col justify-end">
                    <div class="ch-vu-fill w-full bg-sync-green rounded-[1px] transition-all duration-75" style="height: 0%;"></div>
                  </div>
                </div>
              </div>

              <!-- Real-Time Level Readout -->
              <div class="flex items-center justify-between text-[10px] font-mono border-t border-border-milled/70 pt-1.5 px-0.5 mb-2">
                <span class="text-text-dim">GAIN:</span>
                <span class="ch-db-readout font-bold text-bone">0.0 dB</span>
              </div>

              <!-- Tactile Rocker Switches (Origin UI style) -->
              <div class="grid grid-cols-2 gap-2 pt-1 border-t border-border-milled/70">
                <button
                  type="button"
                  class="btn-mute rocker-paddle py-1 px-1.5 rounded-[4px] flex items-center justify-center gap-1 font-mono text-[10px] font-bold uppercase text-text-muted hover:text-bone hover:border-border-active transition-all"
                  aria-label="Mute Channel 1"
                >
                  <span class="led-dot w-1.5 h-1.5 rounded-full bg-border-milled transition-colors"></span>
                  <span>MUTE</span>
                </button>
                <button
                  type="button"
                  class="btn-solo rocker-paddle py-1 px-1.5 rounded-[4px] flex items-center justify-center gap-1 font-mono text-[10px] font-bold uppercase text-text-muted hover:text-bone hover:border-border-active transition-all"
                  aria-label="Solo Channel 1"
                >
                  <span class="led-dot w-1.5 h-1.5 rounded-full bg-border-milled transition-colors"></span>
                  <span>SOLO</span>
                </button>
              </div>
            </div>

            <!-- Channel 02: Peer A -->
            <div class="channel-strip bg-surface-elevated rounded-[6px] p-3 border border-border-milled flex flex-col justify-between relative" data-channel="1">
              <!-- Channel Header -->
              <div class="mb-2">
                <div class="flex items-center justify-between gap-1 mb-1">
