---
---

<section id="simulator" class="border-b border-[#e0e2d3] bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Section Header (Graphify style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-10 border-b border-[#e0e2d3]">
      <div class="max-w-2xl">
        <div class="op-eyebrow">
          <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
          <span>WebAudio Acoustic Testbed</span>
        </div>
        <h2 class="op-title mt-3 text-3xl font-normal tracking-tight text-[#062314] sm:text-4xl md:text-5xl">
          Simulate 4 phones in acoustic sync.
        </h2>
        <p class="op-sub mt-4 text-[#35433a]">
          Experience real acoustic comb filtering caused by Wi-Fi packet jitter, then engage
          RoomBeat’s fractional sinc resampler to witness sub-0.5ms phase-lock convergence in real time.
        </p>
      </div>

      <!-- Quick Start Actions -->
      <div class="flex flex-wrap items-center gap-2.5">
        <button
          id="sim-master-play-btn"
          type="button"
          class="pill lg primary font-mono text-sm shadow-sm"
        >
          <svg id="sim-play-icon" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          <span id="sim-play-text">START AUDIO ENGINE</span>
        </button>

        <button
          id="sim-toggle-lock-btn"
          type="button"
          class="pill lg ghost font-mono text-sm border border-[#e0e2d3]"
        >
          <span id="sim-lock-indicator" class="h-2 w-2 rounded-full bg-[#118d4f]"></span>
          <span id="sim-lock-text">ROOMBEAT LOCKED (0ms)</span>
        </button>
      </div>
    </div>

    <!-- Simulator Instrument Console -->
    <div class="mt-10 overflow-hidden rounded-[4px] border border-[#e0e2d3] bg-[#fbfbf7] shadow-sm">
      <!-- Console Top Header Bar -->
      <div class="flex flex-wrap items-center justify-between border-b border-[#e0e2d3] bg-white px-4 py-3 text-xs">
        <div class="flex items-center gap-3 font-mono text-[#062314]">
          <span class="font-semibold text-xs tracking-wider">CONSOLE: 4-CHANNEL ACOUSTIC RIG</span>
          <span class="text-[#e0e2d3]">|</span>
          <span id="sim-status-badge" class="inline-flex items-center gap-1 font-mono text-[11px] text-[#626b60]">
            <span id="sim-status-dot" class="h-1.5 w-1.5 rounded-full bg-[#626b60]"></span>
            <span id="sim-status-label">ENGINE: STANDBY</span>
          </span>
        </div>

        <div class="flex items-center gap-2">
          <!-- Scope Toggle Mode -->
          <div class="flex items-center rounded-[2px] border border-[#e0e2d3] bg-[#fbfbf7] p-0.5 font-mono text-[11px]">
            <button
              id="scope-mode-radar"
              type="button"
              class="px-2.5 py-1 rounded-[2px] bg-[#062314] text-white font-medium"
            >
              Polar Radar
            </button>
            <button
              id="scope-mode-lissajous"
              type="button"
              class="px-2.5 py-1 rounded-[2px] text-[#626b60] hover:text-[#062314]"
            >
              Lissajous Scope
            </button>
          </div>
        </div>
      </div>

      <!-- Main Split View: Left Scope + Right 4-Channel Strips -->
      <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[#e0e2d3]">
        <!-- Left: Phase Radar / Lissajous Scope (Cols 1-6) -->
        <div class="lg:col-span-6 p-4 sm:p-6 flex flex-col justify-between bg-[#0b140e] text-white min-h-[360px] sm:min-h-[420px]">
          <div class="flex items-center justify-between font-mono text-[11px] text-white/60">
            <span id="scope-title" class="text-[#118d4f] font-semibold">● POLAR ACOUSTIC RADAR</span>
            <span>SWEEP: 48kHz REALTIME</span>
          </div>

          <!-- Scope Canvas Container -->
          <div class="relative my-auto flex h-[280px] sm:h-[320px] w-full items-center justify-center">
            <canvas id="sim-radar-canvas" class="h-full w-full block"></canvas>

            <!-- Scope Mode Overlay Tag -->
            <div class="pointer-events-none absolute bottom-2 right-2 rounded-[2px] border border-white/10 bg-black/60 px-2 py-0.5 font-mono text-[10px] text-white/70 backdrop-blur-sm">
              <span id="scope-phase-correlation">CORRELATION: 0.998 (COHERENT)</span>
            </div>
          </div>

          <div class="flex items-center justify-between border-t border-white/10 pt-3 font-mono text-[11px] text-white/50">
            <span>GRID: CONCENTRIC 10ms ISOLINES</span>
            <span id="scope-hint" class="text-white/70">Green vector = In phase</span>
          </div>
        </div>

        <!-- Right: 4 Phone Channel Fader Strips (Cols 7-12) -->
        <div class="lg:col-span-6 p-4 sm:p-6 bg-white flex flex-col justify-between">
          <div class="flex items-center justify-between border-b border-[#e0e2d3] pb-3 font-mono text-[11px] text-[#626b60]">
            <span>CHANNEL STRIPS (4 PHONES)</span>
            <span class="text-[#062314] font-medium">TEMPO: 124 BPM</span>
          </div>

          <!-- Channel Strips Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-4 my-auto">
            <!-- Channel 1: Host -->
            <div class="channel-strip flex flex-col items-center rounded-[2px] border border-[#e0e2d3] bg-[#fbfbf7] p-2.5" data-ch="0">
              <span class="font-mono text-[10px] uppercase font-bold text-[#118d4f]">HOST REF</span>
              <span class="font-sans text-xs font-semibold text-[#062314] mt-0.5">Pixel 8 Pro</span>
              <span class="ch-delay-badge mt-1 font-mono text-[11px] font-bold text-[#118d4f]">0.0 ms</span>

              <!-- Vertical Meter & Fader -->
              <div class="my-3 flex h-32 w-10 items-center justify-center gap-1.5 rounded-[2px] border border-[#e0e2d3] bg-[#f4f5ec] p-1">
                <!-- VU Meter Bar -->
                <div class="h-full w-2 rounded-[1px] bg-[#e0e2d3] relative overflow-hidden flex flex-col justify-end">
                  <div class="ch-vu-fill w-full bg-[#118d4f] transition-all duration-75" style="height: 0%;"></div>
                </div>
                <!-- Volume Slider Vertical -->
                <input
                  type="range"
                  min="0"
                  max="100"
                  value="75"
                  class="ch-fader h-24 w-1 [writing-mode:vertical-lr] [direction:rtl]"
                  aria-label="Channel 0 Volume"
                />
              </div>

              <span class="ch-db font-mono text-[10px] text-[#626b60]">0.0 dB</span>
              <div class="mt-2 flex gap-1">
                <button type="button" class="btn-mute pill ghost !h-[22px] !px-1.5 font-mono text-[10px] border border-[#e0e2d3]">M</button>
                <button type="button" class="btn-solo pill ghost !h-[22px] !px-1.5 font-mono text-[10px] border border-[#e0e2d3]">S</button>
              </div>
            </div>

            <!-- Channel 2: Peer 1 -->
            <div class="channel-strip flex flex-col items-center rounded-[2px] border border-[#e0e2d3] bg-[#fbfbf7] p-2.5" data-ch="1">
              <span class="font-mono text-[10px] uppercase font-bold text-[#062314]">PEER 1</span>
              <span class="font-sans text-xs font-semibold text-[#062314] mt-0.5">Galaxy S24</span>
              <span class="ch-delay-badge mt-1 font-mono text-[11px] font-bold text-[#118d4f]">0.0 ms</span>

              <div class="my-3 flex h-32 w-10 items-center justify-center gap-1.5 rounded-[2px] border border-[#e0e2d3] bg-[#f4f5ec] p-1">
                <div class="h-full w-2 rounded-[1px] bg-[#e0e2d3] relative overflow-hidden flex flex-col justify-end">
                  <div class="ch-vu-fill w-full bg-[#118d4f] transition-all duration-75" style="height: 0%;"></div>
                </div>
                <input
                  type="range"
                  min="0"
                  max="100"
                  value="75"
                  class="ch-fader h-24 w-1 [writing-mode:vertical-lr] [direction:rtl]"
                  aria-label="Channel 1 Volume"
                />
              </div>

              <span class="ch-db font-mono text-[10px] text-[#626b60]">0.0 dB</span>
              <div class="mt-2 flex gap-1">
                <button type="button" class="btn-mute pill ghost !h-[22px] !px-1.5 font-mono text-[10px] border border-[#e0e2d3]">M</button>
                <button type="button" class="btn-solo pill ghost !h-[22px] !px-1.5 font-mono text-[10px] border border-[#e0e2d3]">S</button>
              </div>
            </div>

            <!-- Channel 3: Peer 2 -->
            <div class="channel-strip flex flex-col items-center rounded-[2px] border border-[#e0e2d3] bg-[#fbfbf7] p-2.5" data-ch="2">
              <span class="font-mono text-[10px] uppercase font-bold text-[#062314]">PEER 2</span>
              <span class="font-sans text-xs font-semibold text-[#062314] mt-0.5">Xiaomi 14</span>
              <span class="ch-delay-badge mt-1 font-mono text-[11px] font-bold text-[#118d4f]">0.0 ms</span>

              <div class="my-3 flex h-32 w-10 items-center justify-center gap-1.5 rounded-[2px] border border-[#e0e2d3] bg-[#f4f5ec] p-1">
                <div class="h-full w-2 rounded-[1px] bg-[#e0e2d3] relative overflow-hidden flex flex-col justify-end">
                  <div class="ch-vu-fill w-full bg-[#118d4f] transition-all duration-75" style="height: 0%;"></div>
                </div>
                <input
                  type="range"
                  min="0"
                  max="100"
                  value="75"
                  class="ch-fader h-24 w-1 [writing-mode:vertical-lr] [direction:rtl]"
                  aria-label="Channel 2 Volume"
                />
              </div>

              <span class="ch-db font-mono text-[10px] text-[#626b60]">0.0 dB</span>
              <div class="mt-2 flex gap-1">
                <button type="button" class="btn-mute pill ghost !h-[22px] !px-1.5 font-mono text-[10px] border border-[#e0e2d3]">M</button>
                <button type="button" class="btn-solo pill ghost !h-[22px] !px-1.5 font-mono text-[10px] border border-[#e0e2d3]">S</button>
              </div>
            </div>

            <!-- Channel 4: Peer 3 -->
            <div class="channel-strip flex flex-col items-center rounded-[2px] border border-[#e0e2d3] bg-[#fbfbf7] p-2.5" data-ch="3">
              <span class="font-mono text-[10px] uppercase font-bold text-[#062314]">PEER 3</span>
              <span class="font-sans text-xs font-semibold text-[#062314] mt-0.5">OnePlus 12</span>
              <span class="ch-delay-badge mt-1 font-mono text-[11px] font-bold text-[#118d4f]">0.0 ms</span>

              <div class="my-3 flex h-32 w-10 items-center justify-center gap-1.5 rounded-[2px] border border-[#e0e2d3] bg-[#f4f5ec] p-1">
                <div class="h-full w-2 rounded-[1px] bg-[#e0e2d3] relative overflow-hidden flex flex-col justify-end">
                  <div class="ch-vu-fill w-full bg-[#118d4f] transition-all duration-75" style="height: 0%;"></div>
                </div>
                <input
                  type="range"
                  min="0"
                  max="100"
                  value="75"
                  class="ch-fader h-24 w-1 [writing-mode:vertical-lr] [direction:rtl]"
                  aria-label="Channel 3 Volume"
                />
              </div>

              <span class="ch-db font-mono text-[10px] text-[#626b60]">0.0 dB</span>
              <div class="mt-2 flex gap-1">
                <button type="button" class="btn-mute pill ghost !h-[22px] !px-1.5 font-mono text-[10px] border border-[#e0e2d3]">M</button>
                <button type="button" class="btn-solo pill ghost !h-[22px] !px-1.5 font-mono text-[10px] border border-[#e0e2d3]">S</button>
              </div>
            </div>
          </div>

          <!-- Bottom Console Telemetry Strips -->
          <div class="border-t border-[#e0e2d3] pt-3 flex flex-wrap items-center justify-between gap-3 font-mono text-[11px]">
            <div class="flex items-center gap-2">
              <span class="text-[#626b60]">JITTER STRESS:</span>
              <button id="sim-btn-jitter" type="button" class="pill ghost !h-[24px] !px-2 border border-[#e0e2d3] text-xs">
                +25ms Spikes
              </button>
            </div>
            <div class="text-[#626b60]">
              PEERS: <span class="text-[#118d4f] font-bold">4 ONLINE</span> · ZERO CLOUD
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WebAudio Engine Client Script -->
<script>
  import { AudioSimulator } from '../scripts/audioSimulator.js';
  import { RadarCanvas } from '../scripts/radarCanvas.js';

  let sim: any = null;
  let radar: any = null;

  function initSimulator() {
    const playBtn = document.getElementById('sim-master-play-btn');
    const playIcon = document.getElementById('sim-play-icon');
    const playText = document.getElementById('sim-play-text');
    const toggleLockBtn = document.getElementById('sim-toggle-lock-btn');
    const lockIndicator = document.getElementById('sim-lock-indicator');
    const lockText = document.getElementById('sim-lock-text');
    const statusDot = document.getElementById('sim-status-dot');
    const statusLabel = document.getElementById('sim-status-label');

    const radarCanvasEl = document.getElementById('sim-radar-canvas') as HTMLCanvasElement;
    const scopeRadarBtn = document.getElementById('scope-mode-radar');
    const scopeLissajousBtn = document.getElementById('scope-mode-lissajous');
    const scopeTitle = document.getElementById('scope-title');
    const jitterStressBtn = document.getElementById('sim-btn-jitter');

    if (!radarCanvasEl) return;

    sim = new AudioSimulator();
    radar = new RadarCanvas(radarCanvasEl, sim);
    radar.init();

    // Play/Pause Master
    if (playBtn && playText) {
      playBtn.addEventListener('click', async () => {
        if (!sim.isPlaying) {
          await sim.start();
          playText.textContent = 'STOP AUDIO ENGINE';
          playBtn.classList.replace('primary', 'ghost');
          playBtn.classList.add('border', 'border-[#e0e2d3]');
          if (statusDot) statusDot.className = 'h-1.5 w-1.5 rounded-full bg-[#118d4f] animate-ping';
          if (statusLabel) statusLabel.textContent = 'ENGINE: RUNNING (124 BPM)';
        } else {
          sim.stop();
          playText.textContent = 'START AUDIO ENGINE';
          playBtn.classList.remove('ghost', 'border', 'border-[#e0e2d3]');
          playBtn.classList.add('primary');
          if (statusDot) statusDot.className = 'h-1.5 w-1.5 rounded-full bg-[#626b60]';
          if (statusLabel) statusLabel.textContent = 'ENGINE: STANDBY';
        }
      });
    }

    // Toggle Phase Lock vs Jitter Flanger
    if (toggleLockBtn && lockIndicator && lockText) {
      toggleLockBtn.addEventListener('click', () => {
        const isLocked = sim.toggleLock();
        if (isLocked) {
          lockIndicator.className = 'h-2 w-2 rounded-full bg-[#118d4f]';
          lockText.textContent = 'ROOMBEAT LOCKED (0ms)';
        } else {
          lockIndicator.className = 'h-2 w-2 rounded-full bg-[#fb651e]';
          lockText.textContent = 'WIFI JITTER DRIFT (+28ms)';
        }
      });
    }

    // Jitter Stress button
    if (jitterStressBtn) {
      jitterStressBtn.addEventListener('click', () => {
        sim.injectJitter();
        if (lockIndicator) lockIndicator.className = 'h-2 w-2 rounded-full bg-[#fb651e]';
        if (lockText) lockText.textContent = 'JITTER INJECTED (+35ms)';
      });
    }

    // Scope Mode buttons
    if (scopeRadarBtn && scopeLissajousBtn && scopeTitle) {
      scopeRadarBtn.addEventListener('click', () => {
        radar.setMode('radar');
        scopeRadarBtn.className = 'px-2.5 py-1 rounded-[2px] bg-[#062314] text-white font-medium';
        scopeLissajousBtn.className = 'px-2.5 py-1 rounded-[2px] text-[#626b60] hover:text-[#062314]';
        scopeTitle.textContent = '● POLAR ACOUSTIC RADAR';
      });

      scopeLissajousBtn.addEventListener('click', () => {
        radar.setMode('lissajous');
        scopeLissajousBtn.className = 'px-2.5 py-1 rounded-[2px] bg-[#062314] text-white font-medium';
        scopeRadarBtn.className = 'px-2.5 py-1 rounded-[2px] text-[#626b60] hover:text-[#062314]';
        scopeTitle.textContent = '● LISSAJOUS PHASE SCOPE';
      });
    }

    // Channel Strips event handlers (faders, mute, solo)
    const strips = document.querySelectorAll('.channel-strip');
    strips.forEach((strip) => {
      const chIdx = parseInt(strip.getAttribute('data-ch') || '0', 10);
      const fader = strip.querySelector('.ch-fader') as HTMLInputElement;
      const dbLabel = strip.querySelector('.ch-db');
      const muteBtn = strip.querySelector('.btn-mute');
      const soloBtn = strip.querySelector('.btn-solo');

      if (fader && dbLabel) {
        fader.addEventListener('input', () => {
          const val = parseInt(fader.value, 10);
          sim.setChannelFader(chIdx, val);
          dbLabel.textContent = AudioSimulator.faderPosToDb(val);
        });
      }

      if (muteBtn) {
        muteBtn.addEventListener('click', () => {
          const isMuted = sim.toggleMute(chIdx);
          muteBtn.classList.toggle('!bg-[#fb651e]', isMuted);
          muteBtn.classList.toggle('!text-white', isMuted);
        });
      }

      if (soloBtn) {
        soloBtn.addEventListener('click', () => {
          const isSolo = sim.toggleSolo(chIdx);
          soloBtn.classList.toggle('!bg-[#118d4f]', isSolo);
          soloBtn.classList.toggle('!text-white', isSolo);
        });
      }
    });

    // Real-time animation loop for VU meters & delay badges
    function telemetryLoop() {
      if (sim) {
        const tel = sim.getTelemetry();
        strips.forEach((strip, idx) => {
          const ch = tel.channels[idx];
          if (!ch) return;

          // Delay badge
          const delayBadge = strip.querySelector('.ch-delay-badge');
          if (delayBadge) {
            if (idx === 0) {
              delayBadge.textContent = '0.0 ms [REF]';
              delayBadge.className = 'ch-delay-badge mt-1 font-mono text-[11px] font-bold text-[#118d4f]';
            } else if (ch.delayMs < 0.5) {
              delayBadge.textContent = '0.0 ms';
              delayBadge.className = 'ch-delay-badge mt-1 font-mono text-[11px] font-bold text-[#118d4f]';
            } else {
              delayBadge.textContent = `+${ch.delayMs.toFixed(1)} ms`;
              delayBadge.className = 'ch-delay-badge mt-1 font-mono text-[11px] font-bold text-[#fb651e]';
            }
          }

          // VU Meter fill
          const vuFill = strip.querySelector('.ch-vu-fill') as HTMLElement;
          if (vuFill) {
            if (!tel.isPlaying || ch.muted) {
              vuFill.style.height = '0%';
            } else {
              const rmsNorm = Math.min(1.0, ch.rms * 3.5);
              const pct = Math.round(rmsNorm * 100);
              vuFill.style.height = `${pct}%`;
              if (pct > 80) {
                vuFill.className = 'ch-vu-fill w-full bg-[#fb651e] transition-all duration-75';
              } else {
                vuFill.className = 'ch-vu-fill w-full bg-[#118d4f] transition-all duration-75';
              }
            }
          }
        });
      }
      requestAnimationFrame(telemetryLoop);
    }

    requestAnimationFrame(telemetryLoop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSimulator);
  } else {
    initSimulator();
  }
</script>
