---
import RoomBeatIcon from './icons/RoomBeatIcon.astro';
import GithubIcon from './icons/GithubIcon.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-[#e0e2d3] bg-white/90 backdrop-blur-md transition-all">
  <!-- Top Announcement Bar (Graphify style) -->
  <div class="border-b border-[#e0e2d3]/60 bg-[#fbfbf7] px-4 py-1.5 text-xs">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <div class="flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap">
        <span class="inline-flex items-center gap-1.5 rounded-[2px] bg-[#062314]/5 px-2 py-0.5 font-mono text-[11px] font-medium text-[#062314]">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#118d4f] opacity-75"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
          </span>
          v1.0.0 STABLE
        </span>
        <span class="text-[#35433a] font-sans">
          Native Android audio synchronization engine · Zero relay cloud · 100% On-device LAN
        </span>
      </div>
      <a
        href="https://github.com/WantedChip/RoomBeat/releases/latest"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1 font-mono text-[11px] font-medium text-[#062314] hover:underline sm:inline-flex"
      >
        <span>Release notes</span>
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6">
    <!-- Brand -->
    <div class="flex items-center gap-6">
      <a href="/" class="group flex items-center gap-2.5 text-[#062314] no-underline">
        <RoomBeatIcon class="h-6 w-6 transition-transform group-hover:scale-105" />
        <span class="font-sans text-base font-semibold tracking-tight text-[#062314]">RoomBeat</span>
        <span class="rounded-[2px] border border-[#e0e2d3] bg-[#f4f5ec] px-1.5 py-0.5 font-mono text-[10px] font-medium text-[#35433a]">
          LAN ENGINE
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 font-sans text-sm font-medium text-[#35433a]">
        <a href="/#features" class="rounded-[2px] px-3 py-1.5 transition-colors hover:bg-[#062314]/5 hover:text-[#062314]">
          Features
        </a>
        <a href="/#simulator" class="rounded-[2px] px-3 py-1.5 transition-colors hover:bg-[#062314]/5 hover:text-[#062314]">
          Sync Simulator
        </a>
        <a href="/#architecture" class="rounded-[2px] px-3 py-1.5 transition-colors hover:bg-[#062314]/5 hover:text-[#062314]">
          Architecture
        </a>
        <a href="/#compare" class="rounded-[2px] px-3 py-1.5 transition-colors hover:bg-[#062314]/5 hover:text-[#062314]">
          Side by side
        </a>
        <a href="/#trust" class="rounded-[2px] px-3 py-1.5 transition-colors hover:bg-[#062314]/5 hover:text-[#062314]">
          Trust
        </a>
        <a href="/#faq" class="rounded-[2px] px-3 py-1.5 transition-colors hover:bg-[#062314]/5 hover:text-[#062314]">
          FAQ
        </a>
      </nav>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-2.5">
      <!-- Live Protocol Telemetry Popover Button (Graphify style) -->
      <div class="relative group/telemetry hidden sm:inline-block">
        <button
          type="button"
          class="pill ghost font-mono text-xs text-[#062314] !h-[30px] !px-2.5 border border-[#e0e2d3]"
          aria-label="Socket Telemetry"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
          <span>UDP MULTICAST</span>
        </button>
        <!-- Hover Telemetry Card -->
        <div class="absolute right-0 top-full mt-2 hidden w-72 rounded-[4px] border border-[#e0e2d3] bg-white p-3.5 shadow-xl group-hover/telemetry:block z-50">
          <div class="border-b border-[#e0e2d3] pb-2 mb-2 flex items-center justify-between">
            <span class="font-mono text-[10px] uppercase tracking-wider text-[#626b60]">Socket Telemetry</span>
            <span class="inline-flex items-center gap-1 font-mono text-[10px] text-[#118d4f]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span> ACTIVE
            </span>
          </div>
          <div class="space-y-1.5 font-mono text-[11px]">
            <div class="flex justify-between text-[#35433a]">
              <span class="text-[#626b60]">Multicast IP:</span>
              <span class="font-semibold text-[#062314]">239.255.42.99</span>
            </div>
            <div class="flex justify-between text-[#35433a]">
              <span class="text-[#626b60]">UDP Port:</span>
              <span class="font-semibold text-[#062314]">4242</span>
            </div>
            <div class="flex justify-between text-[#35433a]">
              <span class="text-[#626b60]">Audio Codec:</span>
              <span class="font-semibold text-[#062314]">Opus 48kHz / 20ms</span>
            </div>
            <div class="flex justify-between text-[#35433a]">
              <span class="text-[#626b60]">Clock Domain:</span>
              <span class="font-semibold text-[#062314]">CLOCK_MONOTONIC</span>
            </div>
            <div class="flex justify-between text-[#35433a]">
              <span class="text-[#626b60]">Acoustic Jitter:</span>
              <span class="font-semibold text-[#118d4f]">0.0 ms (LOCKED)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- GitHub link with star count -->
      <a
        href="https://github.com/WantedChip/RoomBeat"
        target="_blank"
        rel="noopener noreferrer"
        class="pill ghost font-mono text-xs !h-[30px] !px-2.5 border border-[#e0e2d3]"
      >
        <GithubIcon class="h-3.5 w-3.5" />
        <span class="hidden sm:inline">GitHub</span>
        <span class="text-[#626b60] border-l border-[#e0e2d3] pl-1.5 ml-0.5">MIT</span>
      </a>

      <!-- Download APK Primary Pill -->
      <a
        href="https://github.com/WantedChip/RoomBeat/releases/latest"
        class="pill primary !h-[30px] !px-3 font-mono text-xs font-medium"
      >
        <span>Download APK</span>
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M19 12l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden pill ghost !h-[30px] !w-[30px] !p-0 border border-[#e0e2d3]"
        aria-label="Toggle menu"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div id="mobile-nav" class="hidden border-t border-[#e0e2d3] bg-[#fbfbf7] px-4 py-3 md:hidden">
    <div class="flex flex-col gap-2 font-sans text-sm font-medium text-[#35433a]">
      <a href="/#features" class="px-2 py-1.5 hover:text-[#062314]">Features</a>
      <a href="/#simulator" class="px-2 py-1.5 hover:text-[#062314]">Sync Simulator</a>
      <a href="/#architecture" class="px-2 py-1.5 hover:text-[#062314]">Architecture</a>
      <a href="/#compare" class="px-2 py-1.5 hover:text-[#062314]">Side by side</a>
      <a href="/#trust" class="px-2 py-1.5 hover:text-[#062314]">Trust & Open Source</a>
      <a href="/#faq" class="px-2 py-1.5 hover:text-[#062314]">FAQ</a>
      <div class="border-t border-[#e0e2d3] pt-2">
        <a
          href="https://github.com/WantedChip/RoomBeat/releases/latest"
          class="pill primary w-full text-center"
        >
          Download RoomBeat APK (v1.0.0)
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      nav.classList.toggle('hidden');
    });
    // Close on link click
    nav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        nav.classList.add('hidden');
      });
    });
  }
</script>
