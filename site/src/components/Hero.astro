---
import GithubIcon from './icons/GithubIcon.astro';
---

<section id="hero" class="relative overflow-hidden border-b border-[#e0e2d3] bg-white pt-10 pb-16 sm:pt-16 sm:pb-24">
  <!-- Subtle Background Grid with acoustic symbols -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#e0e2d3_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Top Platform Badge (Graphify Backed-by style) -->
    <div class="mb-6 inline-flex items-center gap-2 rounded-[2px] border border-[#e0e2d3] bg-[#fbfbf7] px-3 py-1 font-mono text-xs text-[#062314]">
      <span class="flex h-2 w-2 rounded-full bg-[#118d4f]"></span>
      <span class="font-medium text-[#626b60]">PLATFORM:</span>
      <span class="font-semibold text-[#062314]">Android 11–17 Ready</span>
      <span class="text-[#e0e2d3]">|</span>
      <span class="text-[#626b60]">Min SDK 30</span>
      <span class="text-[#e0e2d3]">|</span>
      <span class="text-[#118d4f] font-medium">Zero Cloud Relay</span>
    </div>

    <!-- Main Typographic Headline (Graphify Geist Mono Ink Lines) -->
    <div class="max-w-4xl">
      <h1 class="font-mono text-3xl font-normal tracking-[-0.04em] text-[#062314] sm:text-5xl md:text-6xl sm:leading-[1.1] leading-[1.15]">
        <span class="block">Turn a room of phones</span>
        <span class="block text-[#062314]">into one massive</span>
        <span class="block text-[#118d4f]">speaker system.</span>
      </h1>

      <p class="mt-6 max-w-2xl font-sans text-base leading-relaxed text-[#35433a] sm:text-lg">
        Perceptually-synchronized audio across every device on your Wi-Fi or hotspot.
        RoomBeat bypasses cloud latency entirely: capturing system audio, slicing 20ms Opus frames,
        and synchronizing hardware playback clocks to within <strong>5 milliseconds</strong>.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="https://github.com/WantedChip/RoomBeat/releases/latest"
          class="pill lg primary font-mono text-sm shadow-sm"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Download APK (v1.0.0)</span>
        </a>

        <a
          href="/#simulator"
          class="pill lg ghost font-mono text-sm border border-[#e0e2d3]"
        >
          <span>Simulate Acoustic Sync</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <a
          href="https://github.com/WantedChip/RoomBeat"
          target="_blank"
          rel="noopener noreferrer"
          class="pill lg outline font-mono text-sm"
        >
          <GithubIcon class="h-4 w-4" />
          <span>Star on GitHub</span>
        </a>
      </div>
    </div>

    <!-- Hero Interactive Acoustic Mesh Canvas (Graphify Interactive Hero Canvas) -->
    <div class="mt-12 overflow-hidden rounded-[4px] border border-[#e0e2d3] bg-[#fbfbf7] shadow-sm">
      <!-- Canvas Header Bar with telemetry & mode switcher -->
      <div class="flex flex-wrap items-center justify-between border-b border-[#e0e2d3] bg-white px-4 py-2.5 text-xs">
        <div class="flex items-center gap-3 font-mono text-[#062314]">
          <span class="flex items-center gap-1.5 font-semibold">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#118d4f] opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[#118d4f]"></span>
            </span>
            ACOUSTIC MESH TOPOLOGY
          </span>
          <span class="hidden text-[#e0e2d3] sm:inline">|</span>
          <span class="hidden font-mono text-[#626b60] sm:inline">MULTICAST: 239.255.42.99:4242</span>
        </div>

        <!-- Interactive Canvas Controls -->
        <div class="flex items-center gap-2">
          <button
            id="hero-trigger-pulse"
            type="button"
            class="pill ghost !h-[26px] !px-2.5 font-mono text-[11px] border border-[#e0e2d3] bg-white hover:bg-[#f4f5ec]"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#fb651e]"></span>
            <span>Pulse Beat</span>
          </button>
          
          <button
            id="hero-toggle-jitter"
            type="button"
            class="pill ghost !h-[26px] !px-2.5 font-mono text-[11px] border border-[#e0e2d3] bg-white hover:bg-[#f4f5ec]"
          >
            <span id="hero-jitter-status-dot" class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
            <span id="hero-jitter-status-text">RoomBeat Phase-Locked (0ms)</span>
          </button>
        </div>
      </div>

      <!-- The Canvas Surface -->
      <div class="relative h-[320px] sm:h-[400px] w-full bg-[#0a120d] overflow-hidden">
        <canvas id="hero-mesh-canvas" class="h-full w-full block cursor-crosshair"></canvas>
        
        <!-- Live HUD Overlays -->
        <div class="pointer-events-none absolute bottom-3 left-3 flex flex-wrap gap-2 font-mono text-[11px]">
          <div class="rounded-[2px] border border-white/10 bg-black/60 px-2.5 py-1 text-white backdrop-blur-sm">
            <span class="text-white/50">PHASE OFFSET:</span> <span id="hud-offset" class="font-bold text-[#118d4f]">0.3 ms</span>
          </div>
          <div class="rounded-[2px] border border-white/10 bg-black/60 px-2.5 py-1 text-white backdrop-blur-sm">
            <span class="text-white/50">PACKET INTERVAL:</span> <span class="font-bold text-white">20.0 ms</span>
          </div>
          <div class="rounded-[2px] border border-white/10 bg-black/60 px-2.5 py-1 text-white backdrop-blur-sm hidden sm:inline-block">
            <span class="text-white/50">ACTIVE NODES:</span> <span class="font-bold text-[#118d4f]">5 / 5 IN SYNC</span>
          </div>
        </div>

        <div class="pointer-events-none absolute top-3 right-3 rounded-[2px] border border-white/10 bg-black/60 px-2.5 py-1 font-mono text-[10px] text-white/70 backdrop-blur-sm hidden sm:block">
          Click canvas to emit acoustic wave · Move cursor to deflect field
        </div>
      </div>

      <!-- Hero Proof Strip (Metrics Bar like Graphify Used-by / Stats) -->
      <div class="grid grid-cols-2 divide-x divide-y sm:divide-y-0 sm:grid-cols-4 divide-[#e0e2d3] border-t border-[#e0e2d3] bg-[#fbfbf7]">
        <div class="p-4 sm:p-5">
          <div class="font-mono text-2xl sm:text-3xl font-semibold tracking-tight text-[#062314]">&lt; 5 ms</div>
          <div class="mt-1 font-sans text-xs text-[#626b60]">Acoustic Phase Alignment</div>
          <div class="mt-0.5 font-mono text-[10px] text-[#118d4f]">Hardware clock synced</div>
        </div>
        <div class="p-4 sm:p-5">
          <div class="font-mono text-2xl sm:text-3xl font-semibold tracking-tight text-[#062314]">8+ Nodes</div>
          <div class="mt-1 font-sans text-xs text-[#626b60]">Simultaneous Phone Rig</div>
          <div class="mt-0.5 font-mono text-[10px] text-[#118d4f]">Zero CPU per extra peer</div>
        </div>
        <div class="p-4 sm:p-5">
          <div class="font-mono text-2xl sm:text-3xl font-semibold tracking-tight text-[#062314]">0 KB</div>
          <div class="mt-1 font-sans text-xs text-[#626b60]">Cloud Traffic Transmitted</div>
          <div class="mt-0.5 font-mono text-[10px] text-[#118d4f]">100% On-device LAN</div>
        </div>
        <div class="p-4 sm:p-5">
          <div class="font-mono text-2xl sm:text-3xl font-semibold tracking-tight text-[#062314]">$0 / FOSS</div>
          <div class="mt-1 font-sans text-xs text-[#626b60]">MIT Open Source License</div>
          <div class="mt-0.5 font-mono text-[10px] text-[#118d4f]">No ads, no subscriptions</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Interactive Hero Mesh Canvas Client Script -->
<script>
  (() => {
    const canvas = document.getElementById('hero-mesh-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let isJittered = false;
    let jitterOffset = 0;
    const triggerPulseBtn = document.getElementById('hero-trigger-pulse');
    const toggleJitterBtn = document.getElementById('hero-toggle-jitter');
    const jitterDot = document.getElementById('hero-jitter-status-dot');
    const jitterText = document.getElementById('hero-jitter-status-text');
    const hudOffset = document.getElementById('hud-offset');

    let width = (canvas.width = canvas.parentElement?.clientWidth || 800);
    let height = (canvas.height = canvas.parentElement?.clientHeight || 400);

    const onResize = () => {
      width = canvas.width = canvas.parentElement?.clientWidth || 800;
      height = canvas.height = canvas.parentElement?.clientHeight || 400;
    };
    window.addEventListener('resize', onResize);

    // Nodes representing phones in the room
    const nodes = [
      { id: 'host', label: 'HOST (Pixel 8)', x: 0.5, y: 0.5, isHost: true, pulse: 0, color: '#118d4f' },
      { id: 'p1', label: 'Living Room', x: 0.22, y: 0.28, isHost: false, pulse: 0, delayMs: 1.8, color: '#e0e2d3' },
      { id: 'p2', label: 'Kitchen', x: 0.78, y: 0.32, isHost: false, pulse: 0, delayMs: 2.4, color: '#e0e2d3' },
      { id: 'p3', label: 'Balcony', x: 0.26, y: 0.74, isHost: false, pulse: 0, delayMs: 3.1, color: '#e0e2d3' },
      { id: 'p4', label: 'Bedroom', x: 0.74, y: 0.76, isHost: false, pulse: 0, delayMs: 2.1, color: '#e0e2d3' },
    ];

    // Wavefronts propagating across the room
    interface Wavefront {
      x: number;
      y: number;
      radius: number;
      maxRadius: number;
      speed: number;
      alpha: number;
      color: string;
    }
    const waves: Wavefront[] = [];

    // Trigger an acoustic wavefront from host or custom point
    function emitWave(originX?: number, originY?: number, isJitter = false) {
      const hX = originX !== undefined ? originX : width * 0.5;
      const hY = originY !== undefined ? originY : height * 0.5;
      waves.push({
        x: hX,
        y: hY,
        radius: 4,
        maxRadius: Math.max(width, height) * 0.85,
        speed: 2.8,
        alpha: 1.0,
        color: isJitter ? '#fb651e' : '#118d4f'
      });
      // Host pulse animation
      nodes[0].pulse = 1.0;
    }

    // Auto-beat pulse every 1.6s
    let lastBeat = performance.now();
    const beatInterval = 1400;

    let mouseX = -100;
    let mouseY = -100;
    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    });
    canvas.addEventListener('mouseleave', () => {
      mouseX = -100;
      mouseY = -100;
    });

    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      emitWave(e.clientX - rect.left, e.clientY - rect.top, isJittered);
    });

    if (triggerPulseBtn) {
      triggerPulseBtn.addEventListener('click', () => {
        emitWave(undefined, undefined, isJittered);
      });
    }

    if (toggleJitterBtn) {
      toggleJitterBtn.addEventListener('click', () => {
        isJittered = !isJittered;
        if (isJittered) {
          if (jitterDot) jitterDot.className = 'h-1.5 w-1.5 rounded-full bg-[#fb651e]';
          if (jitterText) jitterText.textContent = 'Simulating Wi-Fi Jitter (+32ms Flanger Drift)';
          if (hudOffset) {
            hudOffset.textContent = '32.4 ms (DESYNC)';
            hudOffset.className = 'font-bold text-[#fb651e]';
          }
        } else {
          if (jitterDot) jitterDot.className = 'h-1.5 w-1.5 rounded-full bg-[#118d4f]';
          if (jitterText) jitterText.textContent = 'RoomBeat Phase-Locked (0ms)';
          if (hudOffset) {
            hudOffset.textContent = '0.3 ms';
            hudOffset.className = 'font-bold text-[#118d4f]';
          }
        }
      });
    }

    // Animation Loop
    function render(now: number) {
      ctx.clearRect(0, 0, width, height);

      // Automatic heartbeat pulses
      if (now - lastBeat > beatInterval) {
        emitWave(undefined, undefined, isJittered);
        lastBeat = now;
      }

      // Draw subtle coordinate grid
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
      ctx.lineWidth = 1;
      const gridSize = 40;
      for (let x = 0; x < width; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }
      for (let y = 0; y < height; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }

      // Draw multicast connections from host to peers
      const hostNode = nodes[0];
      const hX = hostNode.x * width;
      const hY = hostNode.y * height;

      nodes.forEach((n, idx) => {
        if (n.isHost) return;
        let nX = n.x * width;
        let nY = n.y * height;

        // Apply visual jitter displacement when un-synced
        if (isJittered) {
          const jitterDisplace = Math.sin(now * 0.008 + idx) * 14;
          nX += jitterDisplace;
        }

        // Connection line
        ctx.strokeStyle = isJittered ? 'rgba(251, 101, 30, 0.25)' : 'rgba(17, 141, 79, 0.25)';
        ctx.lineWidth = 1.2;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(hX, hY);
        ctx.lineTo(nX, nY);
        ctx.stroke();
        ctx.setLineDash([]);

        // Animated packet dots traveling down multicast ray
        const progress = ((now * 0.001 * 0.8) + idx * 0.25) % 1;
        const packetX = hX + (nX - hX) * progress;
        const packetY = hY + (nY - hY) * progress;

        ctx.fillStyle = isJittered ? '#fb651e' : '#118d4f';
        ctx.beginPath();
        ctx.arc(packetX, packetY, 2.5, 0, Math.PI * 2);
        ctx.fill();

        // Latency tag on connection midpoint
        const midX = (hX + nX) / 2;
        const midY = (hY + nY) / 2;
        ctx.font = '10px "Geist Mono", monospace';
        ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
        ctx.textAlign = 'center';
        const displayLatency = isJittered ? (n.delayMs + 28.4).toFixed(1) : n.delayMs.toFixed(1);
        ctx.fillText(`${displayLatency}ms`, midX, midY - 6);
      });

      // Update and draw wavefronts
      for (let i = waves.length - 1; i >= 0; i--) {
        const w = waves[i];
        w.radius += w.speed;
        w.alpha = Math.max(0, 1 - w.radius / w.maxRadius);

        ctx.strokeStyle = w.color;
        ctx.globalAlpha = w.alpha * 0.7;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(w.x, w.y, w.radius, 0, Math.PI * 2);
        ctx.stroke();

        // Secondary harmonic ripple
        if (w.radius > 20) {
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(w.x, w.y, w.radius - 16, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Check if wave passes peer nodes to trigger phone glow
        nodes.forEach((n) => {
          if (n.isHost) return;
          const nX = n.x * width;
          const nY = n.y * height;
          const dist = Math.hypot(nX - w.x, nY - w.y);
          if (Math.abs(dist - w.radius) < 6) {
            n.pulse = 1.0;
          }
        });

        if (w.alpha <= 0.01) {
          waves.splice(i, 1);
        }
      }
      ctx.globalAlpha = 1.0;

      // Draw Phone Nodes
      nodes.forEach((n, idx) => {
        let nX = n.x * width;
        let nY = n.y * height;

        if (isJittered && !n.isHost) {
          nX += Math.sin(now * 0.008 + idx) * 14;
        }

        // Pulse decay
        if (n.pulse > 0) {
          n.pulse = Math.max(0, n.pulse - 0.035);
        }

        // Mouse hover interaction: gentle repulsion
        if (mouseX > 0 && mouseY > 0) {
          const d = Math.hypot(nX - mouseX, nY - mouseY);
          if (d < 60) {
            const angle = Math.atan2(nY - mouseY, nX - mouseX);
            const force = (60 - d) * 0.15;
            nX += Math.cos(angle) * force;
            nY += Math.sin(angle) * force;
          }
        }

        // Glow ring on pulse
        if (n.pulse > 0) {
          ctx.strokeStyle = n.isHost ? '#118d4f' : (isJittered ? '#fb651e' : '#118d4f');
          ctx.lineWidth = 1.5;
          ctx.globalAlpha = n.pulse;
          ctx.beginPath();
          ctx.arc(nX, nY, 18 + (1 - n.pulse) * 12, 0, Math.PI * 2);
          ctx.stroke();
          ctx.globalAlpha = 1.0;
        }

        // Node circle background
        ctx.fillStyle = n.isHost ? '#118d4f' : '#16211b';
        ctx.beginPath();
        ctx.arc(nX, nY, n.isHost ? 14 : 10, 0, Math.PI * 2);
        ctx.fill();

        // Node border
        ctx.strokeStyle = n.isHost ? '#ffffff' : (isJittered ? '#fb651e' : '#e0e2d3');
        ctx.lineWidth = n.isHost ? 2.5 : 1.5;
        ctx.stroke();

        // Center dot
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(nX, nY, n.isHost ? 3.5 : 2.5, 0, Math.PI * 2);
        ctx.fill();

        // Labels
        ctx.font = n.isHost ? 'bold 12px "Geist", sans-serif' : '11px "Geist", sans-serif';
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.fillText(n.label, nX, nY + (n.isHost ? 28 : 22));

        // Subtext for host
        if (n.isHost) {
          ctx.font = '10px "Geist Mono", monospace';
          ctx.fillStyle = '#118d4f';
          ctx.fillText('UDP MULTICAST SOURCE', nX, nY + 41);
        }
      });

      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);
  })();
</script>
