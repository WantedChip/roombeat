---
import {
  QrCode,
  Smartphone,
  Camera,
  Copy,
  RefreshCw,
  Check,
  CheckCircle2,
  Radio,
  Terminal,
  ArrowRight,
  Wifi,
  ShieldCheck,
  Zap,
} from 'lucide-astro';
---

<section id="features" class="py-16 md:py-24 border-t border-border-milled relative" aria-labelledby="qr-pin-title">
  <!-- Subtle Industrial Grid Accent -->
  <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[4px] bg-surface-panel border border-border-milled mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-signal-orange"></span>
        <span class="font-mono text-[11px] font-semibold tracking-wider uppercase text-signal-orange">
          Frictionless Discovery · Zero Accounts
        </span>
      </div>
      <h2 id="qr-pin-title" class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-bone tracking-tight leading-tight">
        Instant Dual QR &amp; 6-Digit PIN Room Join
      </h2>
      <p class="mt-4 font-sans text-sm sm:text-base text-text-muted leading-relaxed">
        Zero accounts, zero passwords, zero cloud registration. Listeners join in <strong class="text-bone">&lt;200ms</strong> via direct camera QR scan or by entering an ephemeral 6-digit cryptographic PIN over local mDNS.
      </p>
    </div>

    <!-- Dual Hardware Consoles Grid (Host Console on Left, Listener Join Console on Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- ================= LEFT: HOST BROADCAST CONSOLE ================= -->
      <div class="lg:col-span-6 hardware-panel rounded-[8px] border border-border-milled overflow-hidden">
        
        <!-- Module Header -->
        <div class="bg-[#0D0F13] px-5 py-3.5 border-b border-border-milled flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-[2px] bg-[#07080A] border border-[#3E4454] flex items-center justify-center">
              <span class="w-1 h-1 rounded-full bg-signal-orange"></span>
            </span>
            <span class="font-mono text-xs uppercase tracking-wider text-bone font-bold">
              HOST RACK // M-03 BROADCAST BEACON
            </span>
          </div>
          <span class="font-mono text-[11px] text-sync-green bg-[#00E599]/10 border border-[#00E599]/30 px-2 py-0.5 rounded-[3px] font-semibold">
            STATUS: BROADCASTING
          </span>
        </div>

        <div class="p-6 space-y-6">
          
          <!-- Device Identity Micro-strip -->
          <div class="flex items-center justify-between text-xs font-mono pb-3 border-b border-border-milled/70">
            <div class="flex items-center gap-2">
              <Smartphone class="w-4 h-4 text-signal-orange" />
              <span class="text-bone font-semibold">Google Pixel 8 Pro (Host)</span>
            </div>
            <span class="text-text-dim">192.168.1.105:4242</span>
          </div>

          <!-- Dual Display: QR Code & Large 6-Digit PIN -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
            
            <!-- High-Contrast SVG QR Code Module -->
            <div class="sm:col-span-5 flex flex-col items-center">
              <div class="p-3 bg-[#07080A] rounded-[6px] border border-border-milled relative group">
                <!-- Mechanical Corner Reticle Accents -->
                <div class="absolute -top-1 -left-1 w-2.5 h-2.5 border-t-2 border-l-2 border-signal-orange"></div>
                <div class="absolute -top-1 -right-1 w-2.5 h-2.5 border-t-2 border-r-2 border-signal-orange"></div>
                <div class="absolute -bottom-1 -left-1 w-2.5 h-2.5 border-b-2 border-l-2 border-signal-orange"></div>
                <div class="absolute -bottom-1 -right-1 w-2.5 h-2.5 border-b-2 border-r-2 border-signal-orange"></div>

                <!-- High-Definition Tactile QR SVG -->
                <svg class="w-36 h-36 bg-[#07080A]" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="RoomBeat Room Join QR Code">
                  <!-- Background -->
                  <rect width="120" height="120" fill="#07080A"/>
                  
                  <!-- Top-Left Finder Pattern -->
                  <rect x="8" y="8" width="32" height="32" fill="#F2F4F8"/>
                  <rect x="14" y="14" width="20" height="20" fill="#07080A"/>
                  <rect x="18" y="18" width="12" height="12" fill="#F2F4F8"/>

                  <!-- Top-Right Finder Pattern -->
                  <rect x="80" y="8" width="32" height="32" fill="#F2F4F8"/>
                  <rect x="86" y="14" width="20" height="20" fill="#07080A"/>
                  <rect x="90" y="18" width="12" height="12" fill="#F2F4F8"/>

                  <!-- Bottom-Left Finder Pattern -->
                  <rect x="8" y="80" width="32" height="32" fill="#F2F4F8"/>
                  <rect x="14" y="86" width="20" height="20" fill="#07080A"/>
                  <rect x="18" y="90" width="12" height="12" fill="#F2F4F8"/>

                  <!-- Timing Bars -->
                  <rect x="44" y="20" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="52" y="20" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="60" y="20" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="68" y="20" width="4" height="4" fill="#F2F4F8"/>
                  
                  <rect x="20" y="44" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="20" y="52" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="20" y="60" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="20" y="68" width="4" height="4" fill="#F2F4F8"/>

                  <!-- Data Matrix Bits (Simulated Room URI Payload) -->
                  <rect x="48" y="48" width="6" height="6" fill="#00E599"/>
                  <rect x="58" y="48" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="68" y="48" width="6" height="6" fill="#00E599"/>

                  <rect x="48" y="58" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="58" y="58" width="6" height="6" fill="#FF5500"/>
                  <rect x="68" y="58" width="6" height="6" fill="#F2F4F8"/>

                  <rect x="48" y="68" width="6" height="6" fill="#00E599"/>
                  <rect x="58" y="68" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="68" y="68" width="6" height="6" fill="#00E599"/>

                  <rect x="82" y="44" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="90" y="48" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="100" y="44" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="86" y="56" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="96" y="60" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="82" y="68" width="4" height="4" fill="#F2F4F8"/>

                  <rect x="44" y="82" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="52" y="86" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="60" y="82" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="48" y="94" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="58" y="98" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="68" y="92" width="4" height="4" fill="#F2F4F8"/>

                  <rect x="82" y="82" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="94" y="86" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="86" y="98" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="100" y="94" width="6" height="6" fill="#F2F4F8"/>
                </svg>
              </div>
              <span class="font-mono text-[10px] text-text-dim uppercase tracking-wider mt-2">
                SCAN WITH CAMERAX
              </span>
            </div>

            <!-- Recessed 6-Digit PIN Display Cavity -->
            <div class="sm:col-span-7 space-y-3">
              <div>
                <span class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1">
                  EPHEMERAL ROOM PIN (LOCAL SUBNET)
                </span>
                
                <div class="recessed-cavity rounded-[6px] p-4 text-center border border-border-milled relative">
                  <div class="font-mono font-extrabold text-2xl sm:text-3xl tracking-[0.2em] text-bone select-all" id="host-pin-readout">
                    834 912
                  </div>
                  <span class="font-mono text-[10px] text-sync-green mt-1 inline-block">
                    VALID FOR LOCAL PEERS · NO WAN TRAFFIC
                  </span>
                </div>
              </div>

              <!-- Action Controls Strip -->
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="btn-copy-pin"
                  class="tactile-btn-secondary flex-1 py-2 px-3 text-xs flex items-center justify-center gap-1.5"
                  title="Copy 6-Digit PIN"
                >
                  <Copy class="w-3.5 h-3.5 text-text-muted" />
                  <span id="copy-pin-text">Copy PIN</span>
                </button>

                <button
                  type="button"
                  id="btn-regen-pin"
                  class="tactile-btn-secondary py-2 px-3 text-xs flex items-center justify-center gap-1.5"
                  title="Generate New Cryptographic PIN"
                >
                  <RefreshCw class="w-3.5 h-3.5 text-text-muted" />
                  <span class="hidden sm:inline">Regenerate</span>
                </button>
              </div>
            </div>

          </div>

          <!-- Room Telemetry Strip -->
          <div class="recessed-cavity rounded-[6px] p-3.5 font-mono text-[11px] text-text-dim space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-text-muted">mDNS BROADCAST</span>
              <span class="text-bone">_roombeat._tcp.local</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-text-muted">MULTICAST CHANNEL</span>
              <span class="text-sync-green font-semibold">239.255.42.99:4242</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-text-muted">CONNECTED NODES</span>
              <span class="text-signal-orange font-bold" id="connected-nodes-count">3 NODES LOCKED</span>
            </div>
          </div>

        </div>

      </div>

      <!-- ================= RIGHT: LISTENER JOIN INTERACTIVE CONSOLE ================= -->
      <div class="lg:col-span-6 hardware-panel rounded-[8px] border border-border-milled overflow-hidden">
        
        <!-- Module Header with Join Modes -->
        <div class="bg-[#0D0F13] px-5 py-3 border-b border-border-milled flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-[2px] bg-[#07080A] border border-[#3E4454] flex items-center justify-center">
              <span class="w-1 h-1 rounded-full bg-sync-green"></span>
            </span>
            <span class="font-mono text-xs uppercase tracking-wider text-bone font-bold">
              LISTENER SIMULATOR // DIRECT CLIENT
            </span>
          </div>

          <!-- Mode Selector Tabs -->
          <div class="flex items-center gap-1 bg-[#07080A] p-0.5 rounded-[4px] border border-border-milled text-[11px] font-mono">
            <button
              type="button"
              id="tab-pin-mode"
              class="px-2.5 py-1 rounded-[3px] bg-surface-elevated text-bone font-medium transition-colors border border-border-milled"
            >
              PIN ENTRY
            </button>
            <button
              type="button"
              id="tab-qr-mode"
              class="px-2.5 py-1 rounded-[3px] text-text-dim hover:text-bone transition-colors"
            >
              CAMERA SCAN
            </button>
          </div>
        </div>

        <div class="p-6 space-y-5">
          
          <!-- Mode View 1: 6-Digit PIN Keypad Input -->
          <div id="view-pin-mode" class="space-y-4">
            <div>
              <div class="flex items-center justify-between text-xs font-mono mb-1.5">
                <span class="text-text-dim uppercase">Enter Host 6-Digit PIN:</span>
                <button
                  type="button"
                  id="btn-autofill-pin"
                  class="text-[11px] text-sync-green hover:underline font-mono"
                >
                  [ AUTO-FILL 834 912 ]
                </button>
              </div>

              <!-- Input Digits Display -->
              <div class="recessed-cavity rounded-[6px] p-3 text-center border border-border-milled">
                <div class="font-mono font-bold text-xl sm:text-2xl tracking-[0.3em] text-bone" id="pin-input-display">
                  ______
                </div>
              </div>
            </div>

            <!-- Tactile 12-Key Pad Grid -->
            <div class="grid grid-cols-3 gap-2 max-w-xs mx-auto">
              {['1', '2', '3', '4', '5', '6', '7', '8', '9'].map((digit) => (
                <button
                  type="button"
                  class="keypad-digit-btn tactile-btn-secondary py-2.5 rounded-[4px] font-mono text-sm font-bold text-bone hover:border-sync-green/50 active:scale-[0.98]"
                  data-digit={digit}
                >
                  {digit}
                </button>
              ))}
              
              <button
                type="button"
                id="btn-keypad-clear"
                class="tactile-btn-secondary py-2.5 rounded-[4px] font-mono text-xs font-bold text-sync-red hover:border-sync-red/50 active:scale-[0.98]"
              >
                CLR
              </button>

              <button
                type="button"
                class="keypad-digit-btn tactile-btn-secondary py-2.5 rounded-[4px] font-mono text-sm font-bold text-bone hover:border-sync-green/50 active:scale-[0.98]"
                data-digit="0"
              >
                0
              </button>

              <button
                type="button"
                id="btn-keypad-back"
                class="tactile-btn-secondary py-2.5 rounded-[4px] font-mono text-xs font-bold text-text-muted hover:border-border-active active:scale-[0.98]"
              >
                DEL
              </button>
            </div>

            <!-- Primary Join Trigger Button -->
            <button
              type="button"
              id="btn-simulate-join"
              class="w-full tactile-btn-primary py-2.5 px-4 text-xs font-display font-bold uppercase tracking-wider flex items-center justify-center gap-2"
            >
              <Zap class="w-4 h-4 stroke-[2.5]" />
              <span>CONNECT VIA LOCAL LAN PIN</span>
            </button>
          </div>

          <!-- Mode View 2: Camera QR Scan Simulation (Initially Hidden) -->
          <div id="view-qr-mode" class="hidden space-y-4">
            <div class="recessed-cavity rounded-[6px] p-6 text-center border border-border-milled relative overflow-hidden">
              <!-- Scanning Laser Line Animation -->
              <div class="w-32 h-32 mx-auto rounded-[6px] border-2 border-dashed border-sync-green/40 relative flex items-center justify-center">
                <Camera class="w-8 h-8 text-sync-green/60" />
                <div class="absolute inset-x-0 h-0.5 bg-sync-green shadow-[0_0_8px_#00E599] animate-pulse"></div>
              </div>
              <p class="font-mono text-xs text-text-muted mt-3">
                Pointing CameraX Scanner at Host Display...
              </p>
            </div>

            <button
              type="button"
              id="btn-simulate-qr-scan"
              class="w-full tactile-btn-primary py-2.5 px-4 text-xs font-display font-bold uppercase tracking-wider flex items-center justify-center gap-2"
            >
              <QrCode class="w-4 h-4 stroke-[2.5]" />
              <span>SIMULATE INSTANT QR CAMERA SCAN</span>
            </button>
          </div>

          <!-- Real-Time Handshake Diagnostic Log Terminal -->
          <div class="border-t border-border-milled/70 pt-4">
            <div class="flex items-center justify-between text-[11px] font-mono text-text-dim mb-2">
              <span class="flex items-center gap-1.5 text-bone font-semibold">
                <Terminal class="w-3.5 h-3.5 text-sync-green" />
                HANDSHAKE TELEMETRY LOG
              </span>
              <span id="handshake-elapsed-time" class="text-sync-green font-mono">0.0ms</span>
            </div>

            <div class="recessed-cavity rounded-[4px] p-3 font-mono text-[11px] text-text-dim space-y-1 h-28 overflow-y-auto" id="handshake-terminal-log">
              <div class="text-text-dim">&gt; LISTENER_IDLE: Awaiting PIN entry or QR scan trigger...</div>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<!-- Client Script for Keypad, QR Scanning & Simulated Local Socket Handshake -->
<script>
  function initQrPinDemo() {
    // Host Elements
    const hostPinReadout = document.getElementById('host-pin-readout');
    const btnCopyPin = document.getElementById('btn-copy-pin');
    const copyPinText = document.getElementById('copy-pin-text');
    const btnRegenPin = document.getElementById('btn-regen-pin');
    const connectedNodesCount = document.getElementById('connected-nodes-count');

    // Listener Elements
    const tabPinMode = document.getElementById('tab-pin-mode');
    const tabQrMode = document.getElementById('tab-qr-mode');
    const viewPinMode = document.getElementById('view-pin-mode');
    const viewQrMode = document.getElementById('view-qr-mode');
    const pinInputDisplay = document.getElementById('pin-input-display');
    const btnAutofillPin = document.getElementById('btn-autofill-pin');
    const digitBtns = document.querySelectorAll<HTMLButtonElement>('.keypad-digit-btn');
    const btnKeypadClear = document.getElementById('btn-keypad-clear');
    const btnKeypadBack = document.getElementById('btn-keypad-back');
    const btnSimulateJoin = document.getElementById('btn-simulate-join');
    const btnSimulateQrScan = document.getElementById('btn-simulate-qr-scan');
    const terminalLog = document.getElementById('handshake-terminal-log');
    const elapsedTimeLabel = document.getElementById('handshake-elapsed-time');

    let currentHostPin = '834912';
    let enteredPin = '';
    let isConnecting = false;
    let peerCount = 3;

    function formatPin(pin: string) {
      if (!pin) return '______';
      const padded = pin.padEnd(6, '_');
      return `${padded.slice(0, 3)} ${padded.slice(3, 6)}`;
    }

    function updatePinDisplay() {
      if (pinInputDisplay) {
        pinInputDisplay.textContent = formatPin(enteredPin);
      }
    }

    // Tab Switching
    tabPinMode?.addEventListener('click', () => {
      tabPinMode.classList.add('bg-surface-elevated', 'text-bone', 'border', 'border-border-milled');
      tabPinMode.classList.remove('text-text-dim');
      tabQrMode?.classList.remove('bg-surface-elevated', 'text-bone', 'border', 'border-border-milled');
      tabQrMode?.classList.add('text-text-dim');
      viewPinMode?.classList.remove('hidden');
      viewQrMode?.classList.add('hidden');
    });

    tabQrMode?.addEventListener('click', () => {
      tabQrMode.classList.add('bg-surface-elevated', 'text-bone', 'border', 'border-border-milled');
      tabQrMode.classList.remove('text-text-dim');
      tabPinMode?.classList.remove('bg-surface-elevated', 'text-bone', 'border', 'border-border-milled');
      tabPinMode?.classList.add('text-text-dim');
      viewQrMode?.classList.remove('hidden');
      viewPinMode?.classList.add('hidden');
    });

    // Keypad Digit Buttons
    digitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (enteredPin.length < 6) {
          enteredPin += btn.getAttribute('data-digit') || '';
          updatePinDisplay();
        }
      });
    });

    btnKeypadClear?.addEventListener('click', () => {
      enteredPin = '';
      updatePinDisplay();
    });

    btnKeypadBack?.addEventListener('click', () => {
      if (enteredPin.length > 0) {
        enteredPin = enteredPin.slice(0, -1);
        updatePinDisplay();
      }
    });

    btnAutofillPin?.addEventListener('click', () => {
      enteredPin = currentHostPin;
      updatePinDisplay();
    });

    // Regenerate Cryptographic PIN
    btnRegenPin?.addEventListener('click', () => {
      const randomSixDigit = Math.floor(100000 + Math.random() * 900000).toString();
      currentHostPin = randomSixDigit;
      if (hostPinReadout) {
        hostPinReadout.textContent = `${randomSixDigit.slice(0, 3)} ${randomSixDigit.slice(3, 6)}`;
      }
      if (btnAutofillPin) {
        btnAutofillPin.textContent = `[ AUTO-FILL ${randomSixDigit.slice(0, 3)} ${randomSixDigit.slice(3, 6)} ]`;
      }
      if (copyPinText) {
        copyPinText.textContent = 'Copy PIN';
      }
    });

    // Copy PIN to Clipboard
    btnCopyPin?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(currentHostPin);
        if (copyPinText) {
          copyPinText.textContent = 'Copied!';
          setTimeout(() => {
            if (copyPinText) copyPinText.textContent = 'Copy PIN';
          }, 2000);
        }
      } catch {
        if (copyPinText) copyPinText.textContent = currentHostPin;
      }
    });

    // Execute Simulated Join Sequence
    function runSimulatedHandshake(methodName: string) {
      if (isConnecting) return;
      isConnecting = true;

      if (terminalLog) terminalLog.innerHTML = '';
      if (elapsedTimeLabel) elapsedTimeLabel.textContent = '0.0ms';

      const logSteps = [
        { ms: 12, text: `[+12ms] INIT: Initiating ${methodName} over local Wi-Fi interface...` },
        { ms: 45, text: `[+45ms] DISCOVER: mDNS '_roombeat._tcp' resolved host at 192.168.1.105:4242` },
        { ms: 88, text: `[+88ms] TCP_AUTH: Handshake token verified against PIN [${currentHostPin}]` },
        { ms: 135, text: `[+135ms] NTP_PROBE: 3-roundtrip calibration complete · Offset: -0.18ms · Jitter: 0.4ms` },
        { ms: 168, text: `[+168ms] MULTICAST_LOCK: Joined group 239.255.42.99:4242 · Oboe MMAP exclusive active!` },
        { ms: 172, text: `[+172ms] SYNC_LOCKED: Zero cloud hops. Acoustic sync phase locked across ${peerCount + 1} devices.` }
      ];

      logSteps.forEach((step, idx) => {
        setTimeout(() => {
          if (terminalLog) {
            const line = document.createElement('div');
            line.className = idx === logSteps.length - 1 ? 'text-sync-green font-bold' : 'text-text-muted';
            line.textContent = `> ${step.text}`;
            terminalLog.appendChild(line);
            terminalLog.scrollTop = terminalLog.scrollHeight;
          }
          if (elapsedTimeLabel) {
            elapsedTimeLabel.textContent = `${step.ms}.0ms`;
          }

          if (idx === logSteps.length - 1) {
            isConnecting = false;
            peerCount += 1;
            if (connectedNodesCount) {
              connectedNodesCount.textContent = `${peerCount} NODES LOCKED`;
            }
          }
        }, step.ms * 3.5); // Scaled for visible cinematic cadence (~600ms total)
      });
    }

    btnSimulateJoin?.addEventListener('click', () => {
      if (!enteredPin || enteredPin.length < 6) {
        enteredPin = currentHostPin;
        updatePinDisplay();
      }
      runSimulatedHandshake('6-Digit PIN Handshake');
    });

    btnSimulateQrScan?.addEventListener('click', () => {
      runSimulatedHandshake('CameraX QR Auto-Discovery');
    });
  }

  // Support Astro view transitions / initial page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initQrPinDemo);
  } else {
    initQrPinDemo();
  }
</script>
