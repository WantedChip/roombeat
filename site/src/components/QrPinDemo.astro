---
import {
  QrCode,
  Smartphone,
  Camera,
  Copy,
  RefreshCw,
  Check,
  CheckCircle2,
  Radio,
  Terminal,
  ArrowRight,
  Wifi,
  ShieldCheck,
  Zap,
} from 'lucide-astro';
---

<section id="features" class="py-16 md:py-24 border-t border-border-milled relative" aria-labelledby="qr-pin-title">
  <!-- Subtle Industrial Grid Accent -->
  <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[4px] bg-surface-panel border border-border-milled mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-signal-orange"></span>
        <span class="font-mono text-[11px] font-semibold tracking-wider uppercase text-signal-orange">
          Frictionless Discovery · Zero Accounts
        </span>
      </div>
      <h2 id="qr-pin-title" class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-bone tracking-tight leading-tight">
        Instant Dual QR &amp; 6-Digit PIN Room Join
      </h2>
      <p class="mt-4 font-sans text-sm sm:text-base text-text-muted leading-relaxed">
        Zero accounts, zero passwords, zero cloud registration. Listeners join in <strong class="text-bone">&lt;200ms</strong> via direct camera QR scan or by entering an ephemeral 6-digit cryptographic PIN over local mDNS.
      </p>
    </div>

    <!-- Dual Hardware Consoles Grid (Host Console on Left, Listener Join Console on Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- ================= LEFT: HOST BROADCAST CONSOLE ================= -->
      <div class="lg:col-span-6 hardware-panel rounded-[8px] border border-border-milled overflow-hidden">
        
        <!-- Module Header -->
        <div class="bg-[#0D0F13] px-5 py-3.5 border-b border-border-milled flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-[2px] bg-[#07080A] border border-[#3E4454] flex items-center justify-center">
              <span class="w-1 h-1 rounded-full bg-signal-orange"></span>
            </span>
            <span class="font-mono text-xs uppercase tracking-wider text-bone font-bold">
              HOST RACK // M-03 BROADCAST BEACON
            </span>
          </div>
          <span class="font-mono text-[11px] text-sync-green bg-[#00E599]/10 border border-[#00E599]/30 px-2 py-0.5 rounded-[3px] font-semibold">
            STATUS: BROADCASTING
          </span>
        </div>

        <div class="p-6 space-y-6">
          
          <!-- Device Identity Micro-strip -->
          <div class="flex items-center justify-between text-xs font-mono pb-3 border-b border-border-milled/70">
            <div class="flex items-center gap-2">
              <Smartphone class="w-4 h-4 text-signal-orange" />
              <span class="text-bone font-semibold">Google Pixel 8 Pro (Host)</span>
            </div>
            <span class="text-text-dim">192.168.1.105:4242</span>
          </div>

          <!-- Dual Display: QR Code & Recessed 6-Digit PIN Display -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
            
            <!-- High-Contrast SVG QR Code Module with Laser Viewfinder -->
            <div class="sm:col-span-5 flex flex-col items-center">
              <div class="p-3 bg-[#07080A] rounded-[6px] border border-border-milled relative group overflow-hidden" id="qr-viewfinder-box">
                
                <!-- Industrial Corner Reticle Brackets -->
                <div class="absolute top-1 left-1 w-3 h-3 border-t-2 border-l-2 border-sync-green pointer-events-none z-10"></div>
                <div class="absolute top-1 right-1 w-3 h-3 border-t-2 border-r-2 border-sync-green pointer-events-none z-10"></div>
                <div class="absolute bottom-1 left-1 w-3 h-3 border-b-2 border-l-2 border-sync-green pointer-events-none z-10"></div>
                <div class="absolute bottom-1 right-1 w-3 h-3 border-b-2 border-r-2 border-sync-green pointer-events-none z-10"></div>

                <!-- Continuous Laser Viewfinder Scanning Line -->
                <div class="laser-viewfinder-line" aria-hidden="true">
                  <div class="laser-viewfinder-wash"></div>
                </div>

                <!-- High-Definition Tactile QR SVG -->
                <svg class="w-36 h-36 bg-[#07080A] block" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="RoomBeat Room Join QR Code">
                  <!-- Background -->
                  <rect width="120" height="120" fill="#07080A"/>
                  
                  <!-- Top-Left Finder Pattern -->
                  <rect x="8" y="8" width="32" height="32" fill="#F2F4F8"/>
                  <rect x="14" y="14" width="20" height="20" fill="#07080A"/>
                  <rect x="18" y="18" width="12" height="12" fill="#F2F4F8"/>

                  <!-- Top-Right Finder Pattern -->
                  <rect x="80" y="8" width="32" height="32" fill="#F2F4F8"/>
                  <rect x="86" y="14" width="20" height="20" fill="#07080A"/>
                  <rect x="90" y="18" width="12" height="12" fill="#F2F4F8"/>

                  <!-- Bottom-Left Finder Pattern -->
                  <rect x="8" y="80" width="32" height="32" fill="#F2F4F8"/>
                  <rect x="14" y="86" width="20" height="20" fill="#07080A"/>
                  <rect x="18" y="90" width="12" height="12" fill="#F2F4F8"/>

                  <!-- Timing Bars -->
                  <rect x="44" y="20" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="52" y="20" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="60" y="20" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="68" y="20" width="4" height="4" fill="#F2F4F8"/>
                  
                  <rect x="20" y="44" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="20" y="52" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="20" y="60" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="20" y="68" width="4" height="4" fill="#F2F4F8"/>

                  <!-- Data Matrix Bits (Simulated Room URI Payload) -->
                  <rect x="48" y="48" width="6" height="6" fill="#00E599"/>
                  <rect x="58" y="48" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="68" y="48" width="6" height="6" fill="#00E599"/>

                  <rect x="48" y="58" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="58" y="58" width="6" height="6" fill="#FF5500"/>
                  <rect x="68" y="58" width="6" height="6" fill="#F2F4F8"/>

                  <rect x="48" y="68" width="6" height="6" fill="#00E599"/>
                  <rect x="58" y="68" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="68" y="68" width="6" height="6" fill="#00E599"/>

                  <rect x="82" y="44" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="90" y="48" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="100" y="44" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="86" y="56" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="96" y="60" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="82" y="68" width="4" height="4" fill="#F2F4F8"/>

                  <rect x="44" y="82" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="52" y="86" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="60" y="82" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="48" y="94" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="58" y="98" width="4" height="4" fill="#F2F4F8"/>
                  <rect x="68" y="92" width="4" height="4" fill="#F2F4F8"/>

                  <rect x="82" y="82" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="94" y="86" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="86" y="98" width="6" height="6" fill="#F2F4F8"/>
                  <rect x="100" y="94" width="6" height="6" fill="#F2F4F8"/>
                </svg>

                <!-- Viewfinder HUD Overlays -->
                <div class="absolute bottom-1.5 left-2 font-mono text-[8px] text-sync-green/80 uppercase pointer-events-none">
                  FOV: 78°
                </div>
                <div class="absolute top-1.5 right-2 font-mono text-[8px] text-sync-green/80 uppercase pointer-events-none">
                  60FPS
                </div>
              </div>
              <span class="font-mono text-[10px] text-text-dim uppercase tracking-wider mt-2">
                SCAN WITH CAMERAX
              </span>
            </div>

            <!-- Recessed 6-Digit PIN Readout with Machined Cells -->
            <div class="sm:col-span-7 space-y-3">
              <div>
                <span class="font-mono text-[10px] uppercase tracking-wider text-text-dim block mb-1.5">
                  EPHEMERAL ROOM PIN (LOCAL SUBNET)
                </span>
                
                <!-- Machined Recessed PIN Cavity -->
                <div class="recessed-cavity rounded-[6px] p-3 border border-border-milled relative transition-all" id="host-pin-container">
                  <div class="flex items-center justify-center gap-1.5 sm:gap-2">
                    <!-- 3 Digits -->
                    <span class="host-pin-cell w-8 h-10 sm:w-9 sm:h-12 rounded-[4px] bg-[#0B0D11] border border-border-milled flex items-center justify-center font-mono font-extrabold text-xl sm:text-2xl text-bone shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)]">8</span>
                    <span class="host-pin-cell w-8 h-10 sm:w-9 sm:h-12 rounded-[4px] bg-[#0B0D11] border border-border-milled flex items-center justify-center font-mono font-extrabold text-xl sm:text-2xl text-bone shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)]">3</span>
                    <span class="host-pin-cell w-8 h-10 sm:w-9 sm:h-12 rounded-[4px] bg-[#0B0D11] border border-border-milled flex items-center justify-center font-mono font-extrabold text-xl sm:text-2xl text-bone shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)]">4</span>
                    
                    <span class="text-text-dim font-mono text-base sm:text-lg select-none px-0.5">•</span>

                    <!-- 3 Digits -->
                    <span class="host-pin-cell w-8 h-10 sm:w-9 sm:h-12 rounded-[4px] bg-[#0B0D11] border border-border-milled flex items-center justify-center font-mono font-extrabold text-xl sm:text-2xl text-bone shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)]">9</span>
                    <span class="host-pin-cell w-8 h-10 sm:w-9 sm:h-12 rounded-[4px] bg-[#0B0D11] border border-border-milled flex items-center justify-center font-mono font-extrabold text-xl sm:text-2xl text-bone shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)]">1</span>
                    <span class="host-pin-cell w-8 h-10 sm:w-9 sm:h-12 rounded-[4px] bg-[#0B0D11] border border-border-milled flex items-center justify-center font-mono font-extrabold text-xl sm:text-2xl text-bone shadow-[inset_0_1px_2px_rgba(0,0,0,0.8)]">2</span>
                  </div>

                  <div class="text-center mt-2">
                    <span class="font-mono text-[10px] text-sync-green inline-block">
                      VALID FOR LOCAL PEERS · NO WAN TRAFFIC
                    </span>
                  </div>
                </div>
              </div>

              <!-- Action Controls Strip -->
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="btn-copy-pin"
                  class="tactile-btn-secondary flex-1 py-2 px-3 text-xs flex items-center justify-center gap-1.5 cursor-pointer"
                  title="Copy 6-Digit PIN to Clipboard"
                >
                  <Copy class="w-3.5 h-3.5 text-text-muted" />
                  <span id="copy-pin-text">Copy PIN</span>
                </button>

                <!-- Interactive Regenerate Random PIN Button (GSAP Scramble) -->
                <button
                  type="button"
                  id="btn-regen-pin"
                  class="tactile-btn-secondary py-2 px-3 text-xs flex items-center justify-center gap-1.5 cursor-pointer hover:border-sync-green/60"
                  aria-label="Generate New Cryptographic Random PIN via GSAP"
                  title="Generate New Cryptographic Random PIN via GSAP"
                >
                  <RefreshCw class="w-3.5 h-3.5 text-sync-green" />
                  <span class="hidden sm:inline font-mono">Regenerate</span>
                </button>
              </div>
            </div>

          </div>

          <!-- Room Telemetry Strip -->
          <div class="recessed-cavity rounded-[6px] p-3.5 font-mono text-[11px] text-text-dim space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-text-muted">mDNS BROADCAST</span>
              <span class="text-bone">_roombeat._tcp.local</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-text-muted">MULTICAST CHANNEL</span>
              <span class="text-sync-green font-semibold">239.255.42.99:4242</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-text-muted">CONNECTED NODES</span>
              <span class="text-signal-orange font-bold" id="connected-nodes-count">3 NODES LOCKED</span>
            </div>
          </div>

        </div>

      </div>

      <!-- ================= RIGHT: LISTENER JOIN INTERACTIVE CONSOLE ================= -->
      <div class="lg:col-span-6 hardware-panel rounded-[8px] border border-border-milled overflow-hidden">
        
        <!-- Module Header with Join Modes -->
        <div class="bg-[#0D0F13] px-5 py-3 border-b border-border-milled flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-[2px] bg-[#07080A] border border-[#3E4454] flex items-center justify-center">
              <span class="w-1 h-1 rounded-full bg-sync-green"></span>
            </span>
            <span class="font-mono text-xs uppercase tracking-wider text-bone font-bold">
              LISTENER SIMULATOR // DIRECT CLIENT
            </span>
          </div>

          <!-- Mode Selector Tabs -->
          <div class="flex items-center gap-1 bg-[#07080A] p-0.5 rounded-[4px] border border-border-milled text-[11px] font-mono">
            <button
              type="button"
              id="tab-pin-mode"
              class="px-2.5 py-1 rounded-[3px] bg-surface-elevated text-bone font-medium transition-colors border border-border-milled"
            >
              PIN ENTRY
            </button>
            <button
              type="button"
              id="tab-qr-mode"
              class="px-2.5 py-1 rounded-[3px] text-text-dim hover:text-bone transition-colors"
            >
              CAMERA SCAN
            </button>
          </div>
        </div>

        <div class="p-6 space-y-5">
          
          <!-- Mode View 1: Origin UI Style Recessed 6-Slot Keypad -->
          <div id="view-pin-mode" class="space-y-4">
            <div>
              <div class="flex items-center justify-between text-xs font-mono mb-2">
                <span class="text-text-dim uppercase tracking-wider">Enter Host 6-Digit PIN:</span>
                <button
                  type="button"
                  id="btn-autofill-pin"
                  class="text-[11px] text-sync-green hover:underline font-mono cursor-pointer"
                >
                  [ AUTO-FILL 834 912 ]
                </button>
              </div>

              <!-- Origin UI OTP Input Recessed 6-Slot Container -->
              <div class="p-2 sm:p-3 bg-[#0B0D11] rounded-[8px] border border-border-milled/70">
                <div class="flex items-center justify-center gap-2 sm:gap-3" id="otp-slots-container">
                  <div class="otp-slot is-active" data-index="0"></div>
                  <div class="otp-slot" data-index="1"></div>
                  <div class="otp-slot" data-index="2"></div>
                  <div class="otp-slot" data-index="3"></div>
                  <div class="otp-slot" data-index="4"></div>
                  <div class="otp-slot" data-index="5"></div>
                </div>
              </div>
              <div class="text-center mt-1.5 font-mono text-[10px] text-text-dim">
                CLICK SLOTS OR TYPE ON KEYBOARD · ARROW KEYS TO NAVIGATE
              </div>
            </div>

            <!-- Tactile 12-Key Pad Grid with Physical Click Depression -->
            <div class="grid grid-cols-3 gap-2 max-w-xs mx-auto">
              {['1', '2', '3', '4', '5', '6', '7', '8', '9'].map((digit) => (
                <button
                  type="button"
                  class="keypad-digit-btn tactile-btn-secondary py-2.5 rounded-[4px] font-mono text-sm font-bold text-bone hover:border-sync-green/50 active:scale-[0.98] cursor-pointer"
                  data-digit={digit}
                >
                  {digit}
                </button>
              ))}
              
              <button
                type="button"
                id="btn-keypad-clear"
                class="tactile-btn-secondary py-2.5 rounded-[4px] font-mono text-xs font-bold text-sync-red hover:border-sync-red/50 active:scale-[0.98] cursor-pointer"
              >
                CLR
              </button>

              <button
                type="button"
                class="keypad-digit-btn tactile-btn-secondary py-2.5 rounded-[4px] font-mono text-sm font-bold text-bone hover:border-sync-green/50 active:scale-[0.98] cursor-pointer"
                data-digit="0"
              >
                0
              </button>

              <button
                type="button"
                id="btn-keypad-back"
                class="tactile-btn-secondary py-2.5 rounded-[4px] font-mono text-xs font-bold text-text-muted hover:border-border-active active:scale-[0.98] cursor-pointer"
              >
                DEL
              </button>
            </div>

            <!-- Primary Join Trigger Button -->
            <button
              type="button"
              id="btn-simulate-join"
              class="w-full tactile-btn-primary py-2.5 px-4 text-xs font-display font-bold uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer"
            >
              <Zap class="w-4 h-4 stroke-[2.5]" />
              <span>CONNECT VIA LOCAL LAN PIN</span>
            </button>
          </div>

          <!-- Mode View 2: Camera QR Scan Simulation (Initially Hidden) -->
          <div id="view-qr-mode" class="hidden space-y-4">
            <div class="recessed-cavity rounded-[6px] p-6 text-center border border-border-milled relative overflow-hidden">
              <!-- Scanning Laser Line Animation -->
              <div class="w-32 h-32 mx-auto rounded-[6px] border-2 border-dashed border-sync-green/40 relative flex items-center justify-center overflow-hidden">
                <Camera class="w-8 h-8 text-sync-green/60" />
                <div class="laser-viewfinder-line" aria-hidden="true">
                  <div class="laser-viewfinder-wash"></div>
                </div>
              </div>
              <p class="font-mono text-xs text-text-muted mt-3">
                Pointing CameraX Scanner at Host Display...
              </p>
            </div>

            <button
              type="button"
              id="btn-simulate-qr-scan"
              class="w-full tactile-btn-primary py-2.5 px-4 text-xs font-display font-bold uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer"
            >
              <QrCode class="w-4 h-4 stroke-[2.5]" />
              <span>SIMULATE INSTANT QR CAMERA SCAN</span>
            </button>
          </div>

          <!-- Real-Time Handshake Diagnostic Log Terminal -->
          <div class="border-t border-border-milled/70 pt-4">
            <div class="flex items-center justify-between text-[11px] font-mono text-text-dim mb-2">
              <span class="flex items-center gap-1.5 text-bone font-semibold">
                <Terminal class="w-3.5 h-3.5 text-sync-green" />
                HANDSHAKE TELEMETRY LOG
              </span>
              <span id="handshake-elapsed-time" class="text-sync-green font-mono">0.0ms</span>
            </div>

            <div class="recessed-cavity rounded-[4px] p-3 font-mono text-[11px] text-text-dim space-y-1 h-28 overflow-y-auto" id="handshake-terminal-log">
              <div class="text-text-dim">&gt; LISTENER_IDLE: Awaiting PIN entry or QR scan trigger...</div>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<!-- Viewfinder Laser & Origin UI Recessed Keypad Styles -->
<style>
  @keyframes laserSweep {
    0% {
      top: 0%;
      opacity: 0.85;
    }
    50% {
      top: 100%;
      opacity: 1;
    }
    100% {
      top: 0%;
      opacity: 0.85;
    }
  }

  .laser-viewfinder-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #00E599;
    box-shadow: 0 0 10px #00E599, 0 0 20px rgba(0, 229, 153, 0.7);
    animation: laserSweep 2.8s ease-in-out infinite;
    pointer-events: none;
    z-index: 5;
  }

  .laser-viewfinder-wash {
    position: absolute;
    left: 0;
    right: 0;
    height: 20px;
    transform: translateY(-50%);
    background: linear-gradient(180deg, rgba(0, 229, 153, 0) 0%, rgba(0, 229, 153, 0.22) 50%, rgba(0, 229, 153, 0) 100%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .laser-viewfinder-line {
      animation: none !important;
      top: 50% !important;
    }
  }

  /* Origin UI OTP Recessed 6-Slot Keypad */
  .otp-slot {
    width: 2.75rem;
    height: 3.5rem;
    background-color: #07080A;
    border: 1px solid #262A35;
    border-radius: 6px;
    box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.85), inset 0 0 0 1px rgba(0, 0, 0, 0.5);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: #F2F4F8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
    user-select: none;
    position: relative;
  }

  @media (min-width: 640px) {
    .otp-slot {
      width: 3rem;
      height: 4rem;
      font-size: 1.75rem;
    }
  }

  .otp-slot.is-active {
    border-color: #00E599;
    box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.85), 0 0 12px rgba(0, 229, 153, 0.35);
  }

  .otp-slot.is-active::after {
    content: '';
    position: absolute;
    width: 2px;
    height: 1.25rem;
    background-color: #00E599;
    animation: cursorBlink 1s step-end infinite;
  }

  .otp-slot.is-filled {
    border-color: #3E4454;
    color: #F2F4F8;
  }

  .otp-slot.is-empty {
    color: #5D6475;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<!-- Client Script for Keypad, QR Scanning & Simulated Local Socket Handshake -->
<script>
  import '../scripts/qrPinDemo.js';
</script>
