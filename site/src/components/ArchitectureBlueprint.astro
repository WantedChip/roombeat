---
import {
  Cpu,
  Radio,
  Wifi,
  Volume2,
  Clock,
  Layers,
  Activity,
  ArrowRight,
  ShieldCheck,
  Zap,
} from 'lucide-astro';
---

<section id="architecture" class="py-16 md:py-24 border-t border-border-milled relative" aria-labelledby="architecture-title">
  <!-- Subtle Industrial Grid Accent -->
  <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[4px] bg-surface-panel border border-border-milled mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink"></span>
        <span class="font-mono text-[11px] font-semibold tracking-wider uppercase text-sync-green">
          System Schematic · 20ms Frame Hot Path
        </span>
      </div>
      <h2 id="architecture-title" class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-bone tracking-tight leading-tight">
        The 20ms Opus Architecture Blueprint
      </h2>
      <p class="mt-4 font-sans text-sm sm:text-base text-text-muted leading-relaxed">
        From raw OS audio capture to synchronized multi-device speaker membrane oscillation in <strong class="text-bone">&lt;60ms</strong>. How RoomBeat delivers sub-millisecond acoustic alignment without cloud relays.
      </p>
    </div>

    <!-- Master Blueprint Rack Chassis -->
    <div class="hardware-panel rounded-[8px] overflow-hidden border border-border-milled mb-12">
      
      <!-- Top Control Strip -->
      <div class="bg-[#0D0F13] px-4 sm:px-6 py-3 border-b border-border-milled flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
          <!-- Mechanical Hex Bolt Graphic -->
          <span class="w-2.5 h-2.5 rounded-[2px] bg-[#07080A] border border-[#3E4454] flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-sync-green"></span>
          </span>
          <span class="font-mono text-[11px] uppercase tracking-wider text-text-muted font-medium">
            RACK SCHEMATIC: RB-CORE-V1 // 4-STAGE PIPELINE
          </span>
        </div>
        <div class="flex items-center gap-3 font-mono text-[11px] text-text-dim">
          <span class="hidden sm:inline-block">CLOCK: CLOCK_MONOTONIC_RAW</span>
          <span class="inline-flex items-center gap-1.5 text-signal-orange font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-signal-orange"></span>
            LATENCY BUDGET: 60.0ms
          </span>
        </div>
      </div>

      <!-- 4-Step Interactive Pipeline Grid -->
      <div class="p-4 sm:p-6 lg:p-8 bg-[#101217]/50">
        
        <!-- Signal Flow Header Indicator -->
        <div class="hidden lg:flex items-center justify-between px-2 mb-6 font-mono text-[11px] text-text-dim uppercase tracking-wider border-b border-border-milled/60 pb-3">
          <span>01. Ingest Stage</span>
          <span class="flex items-center gap-1 text-sync-green">PCM Dataflow <ArrowRight class="w-3 h-3" /></span>
          <span>02. Compression &amp; Sync</span>
          <span class="flex items-center gap-1 text-sync-green">Opus Payload <ArrowRight class="w-3 h-3" /></span>
          <span>03. Transport Plane</span>
          <span class="flex items-center gap-1 text-sync-green">UDP Multicast <ArrowRight class="w-3 h-3" /></span>
          <span>04. Acoustic Output</span>
        </div>

        <!-- 4 Step Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6" id="blueprint-steps-container">
          
          <!-- STEP 01: CAPTURE -->
          <div 
            class="blueprint-step-card hardware-card rounded-[6px] p-5 border border-border-milled relative transition-all duration-300 hover:border-sync-green/60 cursor-pointer group"
            data-step="1"
            tabindex="0"
            role="button"
            aria-label="Inspect Step 01: High-Res Audio Ingest"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-signal-orange px-1.5 py-0.5 rounded-[3px] bg-signal-orange/10 border border-signal-orange/30">
                STAGE 01
              </span>
              <div class="w-7 h-7 rounded-[4px] bg-[#07080A] border border-border-milled flex items-center justify-center text-text-muted group-hover:text-sync-green transition-colors">
                <Radio class="w-3.5 h-3.5" />
              </div>
            </div>

            <h3 class="font-display font-bold text-bone text-base tracking-tight mb-1 group-hover:text-white">
              High-Res Capture
            </h3>
            <p class="font-mono text-[11px] text-sync-green font-medium mb-3">
              Zero-Latency PCM Ingest
            </p>

            <p class="font-sans text-xs text-text-muted leading-relaxed mb-4">
              Captures audio via Android 14+ <code class="text-bone text-[11px]">AudioPlaybackCapture</code>, local Storage Access Framework, or Spotify App Remote pre-warmed socket.
            </p>

            <!-- Recessed Telemetry Box -->
            <div class="recessed-cavity rounded-[4px] p-3 font-mono text-[10px] space-y-1.5 text-text-dim">
              <div class="flex justify-between">
                <span>FORMAT</span>
                <span class="text-bone font-semibold">48,000 Hz / 16-Bit</span>
              </div>
              <div class="flex justify-between">
                <span>CHANNELS</span>
                <span class="text-bone font-semibold">Stereo (2-Ch)</span>
              </div>
              <div class="flex justify-between">
                <span>BITRATE</span>
                <span class="text-sync-green font-semibold">1,536 kbps PCM</span>
              </div>
            </div>
            
            <div class="mt-3 flex items-center justify-between text-[10px] font-mono text-text-dim pt-2 border-t border-border-milled/50">
              <span>STATUS: CAPTURING</span>
              <span class="w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink"></span>
            </div>
          </div>

          <!-- STEP 02: TIMESTAMPED ENCODE -->
          <div 
            class="blueprint-step-card hardware-card rounded-[6px] p-5 border border-border-milled relative transition-all duration-300 hover:border-sync-green/60 cursor-pointer group"
            data-step="2"
            tabindex="0"
            role="button"
            aria-label="Inspect Step 02: Native Opus Encode and Timestamping"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-signal-orange px-1.5 py-0.5 rounded-[3px] bg-signal-orange/10 border border-signal-orange/30">
                STAGE 02
              </span>
              <div class="w-7 h-7 rounded-[4px] bg-[#07080A] border border-border-milled flex items-center justify-center text-text-muted group-hover:text-sync-green transition-colors">
                <Cpu class="w-3.5 h-3.5" />
              </div>
            </div>

            <h3 class="font-display font-bold text-bone text-base tracking-tight mb-1 group-hover:text-white">
              Opus &amp; Time-Tag
            </h3>
            <p class="font-mono text-[11px] text-sync-green font-medium mb-3">
              C++ NDK 20ms Framing
            </p>

            <p class="font-sans text-xs text-text-muted leading-relaxed mb-4">
              Native C++ <code class="text-bone text-[11px]">libopus</code> compresses 960 samples into 20ms frames and stamps monotonic clock presentation targets (<code class="text-bone text-[11px]">T_target</code>).
            </p>

            <!-- Recessed Telemetry Box -->
            <div class="recessed-cavity rounded-[4px] p-3 font-mono text-[10px] space-y-1.5 text-text-dim">
              <div class="flex justify-between">
                <span>FRAME SIZE</span>
                <span class="text-bone font-semibold">20.0 ms (960 spl)</span>
              </div>
              <div class="flex justify-between">
                <span>ENCODER</span>
                <span class="text-bone font-semibold">C++20 NDK Opus</span>
              </div>
              <div class="flex justify-between">
                <span>CLOCK TAG</span>
                <span class="text-sync-green font-semibold">T_target (μs Res)</span>
              </div>
            </div>

            <div class="mt-3 flex items-center justify-between text-[10px] font-mono text-text-dim pt-2 border-t border-border-milled/50">
              <span>LATENCY: &lt;1.2ms</span>
              <span class="w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink"></span>
            </div>
          </div>

          <!-- STEP 03: UDP MULTICAST BROADCAST -->
          <div 
            class="blueprint-step-card hardware-card rounded-[6px] p-5 border border-border-milled relative transition-all duration-300 hover:border-sync-green/60 cursor-pointer group"
            data-step="3"
            tabindex="0"
            role="button"
            aria-label="Inspect Step 03: Hardware UDP Multicast Broadcast"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-signal-orange px-1.5 py-0.5 rounded-[3px] bg-signal-orange/10 border border-signal-orange/30">
                STAGE 03
              </span>
              <div class="w-7 h-7 rounded-[4px] bg-[#07080A] border border-border-milled flex items-center justify-center text-text-muted group-hover:text-sync-green transition-colors">
                <Wifi class="w-3.5 h-3.5" />
              </div>
            </div>

            <h3 class="font-display font-bold text-bone text-base tracking-tight mb-1 group-hover:text-white">
              UDP Multicast
            </h3>
            <p class="font-mono text-[11px] text-sync-green font-medium mb-3">
              O(1) Bandwidth Distribution
            </p>

            <p class="font-sans text-xs text-text-muted leading-relaxed mb-4">
              Emits datagrams to <code class="text-bone text-[11px]">239.255.42.99:4242</code>. Holding Android <code class="text-bone text-[11px]">MulticastLock</code> ensures 1 packet reaches 2 or 50 listeners with zero cloud hops.
            </p>

            <!-- Recessed Telemetry Box -->
            <div class="recessed-cavity rounded-[4px] p-3 font-mono text-[10px] space-y-1.5 text-text-dim">
              <div class="flex justify-between">
                <span>MULTICAST IP</span>
                <span class="text-bone font-semibold">239.255.42.99</span>
              </div>
              <div class="flex justify-between">
                <span>PORT</span>
                <span class="text-bone font-semibold">4242 UDP</span>
              </div>
              <div class="flex justify-between">
                <span>COMPLEXITY</span>
                <span class="text-sync-green font-semibold">O(1) Bandwidth</span>
              </div>
            </div>

            <div class="mt-3 flex items-center justify-between text-[10px] font-mono text-text-dim pt-2 border-t border-border-milled/50">
              <span>CADENCE: 50.0 Hz</span>
              <span class="w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink"></span>
            </div>
          </div>

          <!-- STEP 04: SCHEDULED HARDWARE PLAYBACK -->
          <div 
            class="blueprint-step-card hardware-card rounded-[6px] p-5 border border-border-milled relative transition-all duration-300 hover:border-sync-green/60 cursor-pointer group"
            data-step="4"
            tabindex="0"
            role="button"
            aria-label="Inspect Step 04: Hardware Scheduled Playback"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-signal-orange px-1.5 py-0.5 rounded-[3px] bg-signal-orange/10 border border-signal-orange/30">
                STAGE 04
              </span>
              <div class="w-7 h-7 rounded-[4px] bg-[#07080A] border border-border-milled flex items-center justify-center text-text-muted group-hover:text-sync-green transition-colors">
                <Volume2 class="w-3.5 h-3.5" />
              </div>
            </div>

            <h3 class="font-display font-bold text-bone text-base tracking-tight mb-1 group-hover:text-white">
              Hardware Playback
            </h3>
            <p class="font-mono text-[11px] text-sync-green font-medium mb-3">
              Oboe MMAP &amp; Resampler
            </p>

            <p class="font-sans text-xs text-text-muted leading-relaxed mb-4">
              Peer listener nodes feed a jitter buffer with PLC into Oboe AAudio MMAP. Continuous fractional resampling (±0.05%) eliminates clock drift.
            </p>

            <!-- Recessed Telemetry Box -->
            <div class="recessed-cavity rounded-[4px] p-3 font-mono text-[10px] space-y-1.5 text-text-dim">
              <div class="flex justify-between">
                <span>AUDIO API</span>
                <span class="text-bone font-semibold">Oboe (AAudio MMAP)</span>
              </div>
              <div class="flex justify-between">
                <span>PHASE SYNC</span>
                <span class="text-sync-green font-semibold">&lt;0.5ms Locked</span>
              </div>
              <div class="flex justify-between">
                <span>CONCEALMENT</span>
                <span class="text-bone font-semibold">Opus PLC + Resamp</span>
              </div>
            </div>

            <div class="mt-3 flex items-center justify-between text-[10px] font-mono text-text-dim pt-2 border-t border-border-milled/50">
              <span>OUTPUT: 0ms ECHO</span>
              <span class="w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink"></span>
            </div>
          </div>

        </div>

      </div>

      <!-- Live Inspection Terminal Readout (Interactive Drill-Down) -->
      <div class="bg-[#090A0D] p-5 sm:p-6 border-t border-border-milled">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-sync-green animate-status-blink"></span>
            <span class="font-mono text-xs uppercase tracking-wider text-bone font-bold" id="diagnostic-stage-label">
              DIAGNOSTIC INSPECTOR: STAGE 01 // CAPTURE SUBSYSTEM
            </span>
          </div>
          <span class="font-mono text-[11px] text-text-dim">
            CLICK ANY STAGE ABOVE TO INSPECT HOT-PATH REGISTERS
          </span>
        </div>

        <!-- Terminal Output Window -->
        <div class="recessed-cavity rounded-[6px] p-4 font-mono text-xs text-text-muted space-y-2 overflow-x-auto" id="diagnostic-terminal-body">
          <div class="flex items-center gap-2 text-sync-green">
            <span class="text-text-dim">&gt;</span>
            <span id="diagnostic-line-1">AUDIO_CAPTURE: AudioPlaybackCaptureConfiguration initialized on UID target [MediaProjection-Service].</span>
          </div>
          <div class="text-text-muted">
            <span class="text-text-dim">&gt;</span>
            <span id="diagnostic-line-2">PCM_RING_BUFFER: Lock-free SPSC circular queue active · 48000Hz · 16-bit signed interleaved stereo.</span>
          </div>
          <div class="text-text-dim">
            <span class="text-text-dim">&gt;</span>
            <span id="diagnostic-line-3">DISPATCH_METRICS: Ingest buffer latency 1.83ms · 0 dropped samples · CPU thread affinity pinned to core #6.</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Client Script for Step-by-Step Illumination & Interactive Inspection -->
<script>
  interface DiagnosticData {
    label: string;
    line1: string;
    line2: string;
    line3: string;
  }

  const DIAGNOSTIC_MAP: Record<number, DiagnosticData> = {
    1: {
      label: 'DIAGNOSTIC INSPECTOR: STAGE 01 // HIGH-RES AUDIO CAPTURE',
      line1: 'AUDIO_CAPTURE: AudioPlaybackCaptureConfiguration initialized on UID target [MediaProjection-Service].',
      line2: 'PCM_RING_BUFFER: Lock-free SPSC circular queue active · 48000Hz · 16-bit signed interleaved stereo.',
      line3: 'DISPATCH_METRICS: Ingest buffer latency 1.83ms · 0 dropped samples · CPU thread affinity pinned to core #6.',
    },
    2: {
      label: 'DIAGNOSTIC INSPECTOR: STAGE 02 // NATIVE OPUS ENCODER & TIME-TAGGER',
      line1: 'OPUS_ENCODER: opus_encode() invoked with 960 frame_size · 128 kbps VBR · Audio signal mode.',
      line2: 'TIMESTAMP_GEN: T_target = clock_gettime(CLOCK_MONOTONIC_RAW) + 60,000,000 ns presentation deadline.',
      line3: 'CPU_PROFILER: C++20 hot-path execution duration 0.88ms · Zero heap allocations in processing loop.',
    },
    3: {
      label: 'DIAGNOSTIC INSPECTOR: STAGE 03 // HARDWARE UDP MULTICAST BROADCASTER',
      line1: 'MULTICAST_TX: Datagram sent to 239.255.42.99:4242 · Header 24B + Payload 312B = 336B total.',
      line2: 'WIFI_LOCK: WifiManager.MulticastLock ACTIVE · High-perf low-latency lock held.',
      line3: 'FANOUT_BURDEN: O(1) bandwidth complexity · Single socket sendto() delivers to all listening peers.',
    },
    4: {
      label: 'DIAGNOSTIC INSPECTOR: STAGE 04 // HARDWARE-SCHEDULED PLAYBACK & RESAMPLER',
      line1: 'OBOE_AAUDIO: AudioStreamCallback onExclusive MMAP buffer · Latency burst 192 frames @ 48kHz.',
      line2: 'JITTER_BUFFER: 60ms headroom maintained · Native Opus Packet Loss Concealment (PLC) enabled.',
      line3: 'RESAMPLER_LOCK: Fractional speed micro-adjustment ±0.03% · Acoustic phase drift locked to <0.42ms.',
    }
  };

  function initArchitectureBlueprint() {
    const stepCards = document.querySelectorAll<HTMLElement>('.blueprint-step-card');
    const labelElem = document.getElementById('diagnostic-stage-label');
    const line1Elem = document.getElementById('diagnostic-line-1');
    const line2Elem = document.getElementById('diagnostic-line-2');
    const line3Elem = document.getElementById('diagnostic-line-3');

    let activeStep = 1;

    function setActiveStep(step: number, updateCardVisuals = true) {
      activeStep = step;
      const data = DIAGNOSTIC_MAP[step];
      if (!data) return;

      if (labelElem) labelElem.textContent = data.label;
      if (line1Elem) line1Elem.textContent = data.line1;
      if (line2Elem) line2Elem.textContent = data.line2;
      if (line3Elem) line3Elem.textContent = data.line3;

      if (updateCardVisuals) {
        stepCards.forEach((card) => {
          const cardStep = Number(card.getAttribute('data-step'));
          if (cardStep === step) {
            card.classList.add('border-sync-green', 'bg-[#181C24]');
            card.classList.remove('border-border-milled', 'bg-[#1A1D24]');
          } else {
            card.classList.remove('border-sync-green', 'bg-[#181C24]');
            card.classList.add('border-border-milled', 'bg-[#1A1D24]');
          }
        });
      }
    }

    // Attach click and keyboard listeners to cards
    stepCards.forEach((card) => {
      card.addEventListener('click', () => {
        const step = Number(card.getAttribute('data-step'));
        setActiveStep(step);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const step = Number(card.getAttribute('data-step'));
          setActiveStep(step);
        }
      });
    });

    // Lightweight IntersectionObserver for scroll-based illumination
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const step = Number(entry.target.getAttribute('data-step'));
            if (step && step !== activeStep) {
              setActiveStep(step);
            }
          }
        });
      }, {
        root: null,
        rootMargin: '0px 0px -20% 0px',
        threshold: 0.5,
      });

      stepCards.forEach((card) => observer.observe(card));
    }

    // Initialize with Step 1 active
    setActiveStep(1);
  }

  // Support Astro view transitions / initial page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArchitectureBlueprint);
  } else {
    initArchitectureBlueprint();
  }
</script>
