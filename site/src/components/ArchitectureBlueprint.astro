---
import {
  Cpu,
  Radio,
  Wifi,
  Volume2,
  Clock,
  Layers,
  Activity,
  ArrowRight,
  ShieldCheck,
  Zap,
  Terminal,
  Copy,
  Play,
  Pause,
  SkipForward,
} from 'lucide-astro';
---

<section id="architecture" class="py-16 md:py-24 border-t border-border-milled relative" aria-labelledby="architecture-title">
  <!-- Subtle Industrial Grid Accent -->
  <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[4px] bg-surface-panel border border-border-milled mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-sync-green animate-status-blink"></span>
        <span class="font-mono text-[11px] font-semibold tracking-wider uppercase text-sync-green">
          System Schematic · 20ms Frame Hot Path
        </span>
      </div>
      <h2 id="architecture-title" class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-bone tracking-tight leading-tight">
        The 20ms Opus Architecture Blueprint
      </h2>
      <p class="mt-4 font-sans text-sm sm:text-base text-text-muted leading-relaxed">
        From raw OS audio capture to synchronized multi-device speaker membrane oscillation in <strong class="text-bone">&lt;60ms</strong>. How RoomBeat delivers sub-millisecond acoustic alignment without cloud relays.
      </p>
    </div>

    <!-- Master Blueprint Rack Chassis -->
    <div class="hardware-panel rounded-[8px] overflow-hidden border border-border-milled mb-12">
      
      <!-- Top Control Strip -->
      <div class="bg-[#0D0F13] px-4 sm:px-6 py-3 border-b border-border-milled flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
          <!-- Mechanical Hex Bolt Graphic -->
          <span class="w-2.5 h-2.5 rounded-[2px] bg-[#07080A] border border-[#3E4454] flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-sync-green"></span>
          </span>
          <span class="font-mono text-[11px] uppercase tracking-wider text-text-muted font-medium">
            RACK SCHEMATIC: RB-CORE-V1 // 4-STAGE PIPELINE
          </span>
        </div>
        <div class="flex items-center gap-4 font-mono text-[11px] text-text-dim">
          <span class="hidden sm:inline-block">CLOCK: CLOCK_MONOTONIC_RAW</span>
          <span class="inline-flex items-center gap-1.5 text-signal-orange font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-signal-orange animate-pulse"></span>
            LATENCY BUDGET: 60.0ms
          </span>
        </div>
      </div>

      <!-- 4-Stage Vertical Tracing Beam Conduit Container -->
      <div class="p-4 sm:p-6 lg:p-8 bg-[#101217]/50 relative" id="architecture-blueprint-container">
        
        <div class="relative flex gap-4 sm:gap-8 lg:gap-12">
          
          <!-- Aceternity Tracing Beam Vertical Conduit Spine -->
          <div class="w-8 sm:w-12 shrink-0 relative flex flex-col justify-between py-6 items-center">
            <!-- Full Height Background & Animated SVG Tracing Beam -->
            <svg id="tracing-beam-svg" class="absolute inset-0 w-full h-full pointer-events-none overflow-visible" aria-hidden="true">
              <defs>
                <linearGradient id="tracing-beam-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#FF5500" stop-opacity="0.9" />
                  <stop offset="50%" stop-color="#00E599" stop-opacity="1" />
                  <stop offset="100%" stop-color="#00D2FF" stop-opacity="0.9" />
                </linearGradient>
                <filter id="beam-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="3.5" result="blur" />
                  <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>
              </defs>
              <!-- Milled Conduit Track -->
              <path id="tracing-beam-track" stroke="#262A35" stroke-width="2.5" stroke-linecap="round" fill="none" />
              <!-- Active Scrubbed Glowing Beam -->
              <path id="tracing-beam-path" stroke="url(#tracing-beam-grad)" stroke-width="3" stroke-linecap="round" fill="none" filter="url(#beam-glow)" />
              <!-- Traveling Signal Head Bead -->
              <circle id="tracing-beam-head" r="5" fill="#00E599" filter="url(#beam-glow)" opacity="0" />
            </svg>

            <!-- 4 Stage Port Nodes Along Beam -->
            <div class="tracing-stage-port w-8 h-8 rounded-full bg-[#07080A] border border-[#262A35] flex items-center justify-center font-mono text-[10px] font-bold text-text-dim relative z-10 transition-all duration-300" data-stage="1">
              <span class="stage-num">01</span>
              <span class="port-led absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-signal-orange/60"></span>
            </div>

            <div class="tracing-stage-port w-8 h-8 rounded-full bg-[#07080A] border border-[#262A35] flex items-center justify-center font-mono text-[10px] font-bold text-text-dim relative z-10 transition-all duration-300" data-stage="2">
              <span class="stage-num">02</span>
              <span class="port-led absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-signal-orange/60"></span>
            </div>

            <div class="tracing-stage-port w-8 h-8 rounded-full bg-[#07080A] border border-[#262A35] flex items-center justify-center font-mono text-[10px] font-bold text-text-dim relative z-10 transition-all duration-300" data-stage="3">
              <span class="stage-num">03</span>
              <span class="port-led absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-signal-orange/60"></span>
            </div>

            <div class="tracing-stage-port w-8 h-8 rounded-full bg-[#07080A] border border-[#262A35] flex items-center justify-center font-mono text-[10px] font-bold text-text-dim relative z-10 transition-all duration-300" data-stage="4">
              <span class="stage-num">04</span>
              <span class="port-led absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-sync-green/60"></span>
            </div>
          </div>

          <!-- 4 Stage Detail Cards Stack -->
          <div class="flex-1 space-y-6">
            
            <!-- STAGE 01: CAPTURE -->
            <div 
              class="blueprint-stage-card hardware-card rounded-[8px] p-5 sm:p-6 border border-border-milled transition-all duration-300 hover:border-sync-green/50 cursor-pointer group is-active"
              data-stage="1"
              tabindex="0"
              role="button"
              aria-label="Inspect Stage 01: High-Res Audio Ingest"
            >
              <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold text-signal-orange px-2 py-0.5 rounded-[3px] bg-signal-orange/10 border border-signal-orange/30">
                    STAGE 01
                  </span>
                  <span class="font-mono text-[11px] text-text-dim uppercase tracking-wider">
                    OS INGEST BUS // ZERO-COPY DMA
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[11px] text-sync-green font-semibold">1,536 kbps PCM</span>
                  <div class="w-7 h-7 rounded-[4px] bg-[#07080A] border border-border-milled flex items-center justify-center text-text-muted group-hover:text-sync-green transition-colors">
                    <Radio class="w-3.5 h-3.5" />
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <div class="lg:col-span-7">
                  <h3 class="font-display font-bold text-bone text-lg tracking-tight mb-1 group-hover:text-white">
                    High-Res Audio Capture &amp; SPSC Queue
                  </h3>
                  <p class="font-sans text-xs sm:text-sm text-text-muted leading-relaxed mb-3">
                    Captures system audio via Android 14+ <code class="text-bone text-[11px] font-mono">AudioPlaybackCaptureConfiguration</code> (MediaProjection foreground service), local Storage Access Framework, or pre-warmed Spotify App Remote socket.
                  </p>
                  <p class="font-sans text-xs text-text-dim leading-relaxed">
                    Raw PCM data is fed into a lock-free Single-Producer Single-Consumer (SPSC) ring buffer with CPU affinity pinned to high-efficiency core #6, preventing audio thread preemption.
                  </p>
                </div>

                <!-- Recessed Telemetry Box -->
                <div class="lg:col-span-5 recessed-cavity rounded-[6px] p-3.5 font-mono text-[11px] space-y-2 text-text-dim">
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">SAMPLE FORMAT:</span>
                    <span class="text-bone font-semibold">48,000 Hz / 16-Bit Signed</span>
                  </div>
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">CHANNELS:</span>
                    <span class="text-bone font-semibold">Stereo (2-Ch Interleaved)</span>
                  </div>
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">RING BUFFER:</span>
                    <span class="text-sync-green font-semibold">Lock-Free SPSC (0 Copy)</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">INGEST LATENCY:</span>
                    <span class="text-sync-green font-semibold">&lt; 1.85 ms</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- STAGE 02: ENCODE & TIME-TAG -->
            <div 
              class="blueprint-stage-card hardware-card rounded-[8px] p-5 sm:p-6 border border-border-milled transition-all duration-300 hover:border-sync-green/50 cursor-pointer group"
              data-stage="2"
              tabindex="0"
              role="button"
              aria-label="Inspect Stage 02: Native Opus Compression and Monotonic Time-Tagging"
            >
              <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold text-signal-orange px-2 py-0.5 rounded-[3px] bg-signal-orange/10 border border-signal-orange/30">
                    STAGE 02
                  </span>
                  <span class="font-mono text-[11px] text-text-dim uppercase tracking-wider">
                    C++20 NDK ENGINE // 20ms OPUS FRAMING
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[11px] text-sync-green font-semibold">960 Samples / Frame</span>
                  <div class="w-7 h-7 rounded-[4px] bg-[#07080A] border border-border-milled flex items-center justify-center text-text-muted group-hover:text-sync-green transition-colors">
                    <Cpu class="w-3.5 h-3.5" />
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <div class="lg:col-span-7">
                  <h3 class="font-display font-bold text-bone text-lg tracking-tight mb-1 group-hover:text-white">
                    Native Opus Compression &amp; Monotonic Time-Tagging
                  </h3>
                  <p class="font-sans text-xs sm:text-sm text-text-muted leading-relaxed mb-3">
                    Native C++ <code class="text-bone text-[11px] font-mono">libopus 1.5.2</code> compresses 960 stereo samples into 20ms frames at 128 kbps VBR. Zero heap allocations occur in the hot-path audio thread.
                  </p>
                  <p class="font-sans text-xs text-text-dim leading-relaxed">
                    Attaches a 24-byte RoomBeat packet header: 3-byte magic signature <code class="text-sync-green font-mono">0x52, 0x42, 0x01</code>, sequence counter, and nanosecond target presentation timestamp <code class="text-bone font-mono">T_target = CLOCK_MONOTONIC_RAW + 60ms</code>.
                  </p>
                </div>

                <!-- Recessed Telemetry Box -->
                <div class="lg:col-span-5 recessed-cavity rounded-[6px] p-3.5 font-mono text-[11px] space-y-2 text-text-dim">
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">FRAME DURATION:</span>
                    <span class="text-bone font-semibold">20.00 ms (50.0 Hz)</span>
                  </div>
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">OPUS BITRATE:</span>
                    <span class="text-bone font-semibold">128 kbps VBR (Audio Mode)</span>
                  </div>
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">MAGIC HEADER:</span>
                    <span class="text-sync-green font-semibold">0x52, 0x42, 0x01 (RB1)</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">ENCODE DURATION:</span>
                    <span class="text-sync-green font-semibold">&lt; 0.88 ms (C++20 NDK)</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- STAGE 03: HARDWARE UDP MULTICAST -->
            <div 
              class="blueprint-stage-card hardware-card rounded-[8px] p-5 sm:p-6 border border-border-milled transition-all duration-300 hover:border-sync-green/50 cursor-pointer group"
              data-stage="3"
              tabindex="0"
              role="button"
              aria-label="Inspect Stage 03: Hardware UDP Multicast Broadcast"
            >
              <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold text-signal-orange px-2 py-0.5 rounded-[3px] bg-signal-orange/10 border border-signal-orange/30">
                    STAGE 03
                  </span>
                  <span class="font-mono text-[11px] text-text-dim uppercase tracking-wider">
                    TRANSPORT PLANE // O(1) MULTICAST
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[11px] text-sync-green font-semibold">239.255.42.99:4242</span>
                  <div class="w-7 h-7 rounded-[4px] bg-[#07080A] border border-border-milled flex items-center justify-center text-text-muted group-hover:text-sync-green transition-colors">
                    <Wifi class="w-3.5 h-3.5" />
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <div class="lg:col-span-7">
                  <h3 class="font-display font-bold text-bone text-lg tracking-tight mb-1 group-hover:text-white">
                    Hardware UDP Multicast &amp; MulticastLock
                  </h3>
                  <p class="font-sans text-xs sm:text-sm text-text-muted leading-relaxed mb-3">
                    Emits datagrams directly to multicast group <code class="text-bone text-[11px] font-mono">239.255.42.99:4242</code>. Holding Android's kernel <code class="text-bone text-[11px] font-mono">WifiManager.MulticastLock</code> ensures unfiltered packet reception on all listening nodes.
                  </p>
                  <p class="font-sans text-xs text-text-dim leading-relaxed">
                    O(1) bandwidth complexity: a single 336-byte datagram reaches 2 or 64 phones simultaneously over local Wi-Fi or portable hotspot with zero cloud relay hops.
                  </p>
                </div>

                <!-- Recessed Telemetry Box -->
                <div class="lg:col-span-5 recessed-cavity rounded-[6px] p-3.5 font-mono text-[11px] space-y-2 text-text-dim">
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">DATAGRAM SIZE:</span>
                    <span class="text-bone font-semibold">336 Bytes (24B Hdr + 312B Pld)</span>
                  </div>
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">BURST CADENCE:</span>
                    <span class="text-bone font-semibold">50.0 Hz (Every 20.0ms)</span>
                  </div>
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">FANOUT SCALING:</span>
                    <span class="text-sync-green font-semibold">O(1) Unlimited Peers</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">CLOUD DEPENDENCY:</span>
                    <span class="text-sync-green font-semibold">0 Cloud Hops (100% LAN)</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- STAGE 04: PLAYBACK & DRIFT RESAMPLER -->
            <div 
              class="blueprint-stage-card hardware-card rounded-[8px] p-5 sm:p-6 border border-border-milled transition-all duration-300 hover:border-sync-green/50 cursor-pointer group"
              data-stage="4"
              tabindex="0"
              role="button"
              aria-label="Inspect Stage 04: Scheduled Hardware Playback and Fractional Resampler"
            >
              <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold text-signal-orange px-2 py-0.5 rounded-[3px] bg-signal-orange/10 border border-signal-orange/30">
                    STAGE 04
                  </span>
                  <span class="font-mono text-[11px] text-text-dim uppercase tracking-wider">
                    ACOUSTIC SINK // OBOE MMAP &amp; RESAMPLER
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[11px] text-sync-green font-semibold">&lt; 0.5ms Phase Lock</span>
                  <div class="w-7 h-7 rounded-[4px] bg-[#07080A] border border-border-milled flex items-center justify-center text-text-muted group-hover:text-sync-green transition-colors">
                    <Volume2 class="w-3.5 h-3.5" />
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <div class="lg:col-span-7">
                  <h3 class="font-display font-bold text-bone text-lg tracking-tight mb-1 group-hover:text-white">
                    Hardware-Scheduled Playback &amp; Fractional Resampler
                  </h3>
                  <p class="font-sans text-xs sm:text-sm text-text-muted leading-relaxed mb-3">
                    Peer listener nodes queue frames into a 60ms scheduled jitter buffer with Opus Packet Loss Concealment (PLC). Audio renders via Google Oboe AAudio Exclusive MMAP DMA buffers.
                  </p>
                  <p class="font-sans text-xs text-text-dim leading-relaxed">
                    A continuous Catmull-Rom fractional resampler applies subtle speed micro-adjustments (<code class="text-bone font-mono">±0.05%</code>) against the master clock, locking phase alignment down to <strong class="text-sync-green">&lt;0.5ms</strong> with zero acoustic comb filtering.
                  </p>
                </div>

                <!-- Recessed Telemetry Box -->
                <div class="lg:col-span-5 recessed-cavity rounded-[6px] p-3.5 font-mono text-[11px] space-y-2 text-text-dim">
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">AUDIO API:</span>
                    <span class="text-bone font-semibold">Oboe AAudio (MMAP Exclusive)</span>
                  </div>
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">JITTER BUFFER:</span>
                    <span class="text-bone font-semibold">60ms Headroom + Opus PLC</span>
                  </div>
                  <div class="flex justify-between border-b border-border-milled/50 pb-1">
                    <span class="text-text-muted">RESAMPLER SLEW:</span>
                    <span class="text-sync-green font-semibold">±0.05% (Pitch-Neutral)</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">PHASE DRIFT:</span>
                    <span class="text-sync-green font-semibold">&lt; 0.5 ms (No Chorus Echo)</span>
                  </div>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- ================= INTERACTIVE TERMINAL BAY: LIVE 20ms OPUS HEX DUMP ================= -->
      <div class="bg-[#090A0D] p-4 sm:p-6 border-t border-border-milled">
        
        <!-- Terminal Header Strip -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2.5">
            <span id="stream-status-led" class="w-2 h-2 rounded-full bg-sync-green animate-status-blink"></span>
            <span class="font-mono text-xs uppercase tracking-wider text-bone font-bold">
              BAY 05: OPUS-HEX-DISSECTOR // 20ms PACKET ANALYZER
            </span>
            <span id="stream-status-text" class="hidden sm:inline-block font-mono text-[10px] text-sync-green bg-sync-green/10 border border-sync-green/30 px-1.5 py-0.5 rounded-[2px]">
              50.0 Hz RX (20ms)
            </span>
          </div>

          <!-- Controls & Mode Selector -->
          <div class="flex items-center gap-2">
            <!-- Tabs -->
            <div class="flex items-center gap-1 bg-[#07080A] p-0.5 rounded-[4px] border border-border-milled text-[11px] font-mono">
              <button
                type="button"
                id="tab-hex-stream"
                class="px-2.5 py-1 rounded-[3px] bg-surface-elevated text-bone font-medium transition-colors border border-border-milled"
              >
                HEX PACKET STREAM
              </button>
              <button
                type="button"
                id="tab-stage-regs"
                class="px-2.5 py-1 rounded-[3px] text-text-dim hover:text-bone transition-colors"
              >
                STAGE REGISTERS
              </button>
            </div>

            <!-- Next Packet Trigger -->
            <button
              type="button"
              id="btn-next-packet"
              class="tactile-btn-secondary px-2.5 py-1 text-[11px] font-mono flex items-center gap-1 hover:border-sync-green/50"
              title="Inspect Next 20ms Packet Frame"
            >
              <SkipForward class="w-3 h-3 text-sync-green" />
              <span class="hidden sm:inline">NEXT</span>
            </button>

            <!-- Stream Pause / Resume -->
            <button
              type="button"
              id="btn-toggle-stream"
              class="tactile-btn-secondary px-2.5 py-1 text-[11px] font-mono flex items-center gap-1"
              title="Pause or Resume Live Packet Ingestion"
            >
              PAUSE ||
            </button>

            <!-- Copy Hex Button -->
            <button
              type="button"
              id="btn-copy-hex"
              class="tactile-btn-secondary px-2.5 py-1 text-[11px] font-mono flex items-center gap-1"
              title="Copy Packet Hex to Clipboard"
            >
              <Copy class="w-3 h-3 text-text-muted" />
              <span class="hidden sm:inline">COPY HEX</span>
            </button>
          </div>
        </div>

        <!-- Terminal View 1: Live Hex Stream & Field Dissector Grid -->
        <div id="view-hex-stream" class="space-y-4">
          
          <!-- Monospace Hex Window (React Bits Decrypted Text Effect) -->
          <div class="recessed-cavity rounded-[6px] p-4 font-mono text-xs overflow-x-auto border border-border-milled relative">
            <div class="flex items-center justify-between text-[11px] text-text-dim pb-2 mb-2 border-b border-border-milled/60 font-mono">
              <div class="flex items-center gap-4">
                <span>DATAGRAM: 336 BYTES</span>
                <span>CADENCE: 20.0ms</span>
                <span class="text-sync-green">SEQ: <span id="packet-meta-seq">#102,220</span></span>
              </div>
              <div class="hidden sm:flex items-center gap-2">
                <span>T_TARGET:</span>
                <span id="packet-meta-time" class="text-sync-amber">1737458000.060000s</span>
              </div>
            </div>

            <!-- Hex Rows Render Target -->
            <div id="terminal-hex-body" class="space-y-1 text-xs">
              <!-- Rendered via architectureBlueprint.js with live decryption effect -->
            </div>
          </div>

          <!-- Interactive Field Inspector Breakdown Card -->
          <div id="field-inspector-card" class="bg-surface-elevated rounded-[6px] p-4 border border-border-milled transition-all duration-200">
            <div class="flex items-center justify-between border-b border-border-milled/70 pb-2 mb-2">
              <span class="font-mono text-xs font-bold text-bone flex items-center gap-2">
