---
---

<section id="trust" class="border-b border-[#e0e2d3] bg-[#fbfbf7] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Header (Graphify style) -->
    <div class="max-w-3xl">
      <div class="op-eyebrow">
        <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
        <span>Trust &amp; Engineering Ethics</span>
      </div>
      <h2 class="op-title mt-3 text-3xl font-normal tracking-tight text-[#062314] sm:text-4xl md:text-5xl">
        Run it on your phones. No accounts, no subscriptions, no cloud.
      </h2>
      <p class="op-sub mt-4 text-[#35433a]">
        The RoomBeat audio engine runs 100% on your hardware. It will never ask for your email address,
        will never phone home to a tracking server, and will never lock audio features behind a paywall.
      </p>
    </div>

    <!-- 4 Cards Grid (Graphify Trust Cards) -->
    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1: On-Device -->
      <div class="fcard p-6 bg-white flex flex-col justify-between">
        <div>
          <div class="font-mono text-xs font-semibold text-[#118d4f] flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
            <span>01 · ON-DEVICE ONLY</span>
          </div>
          <h3 class="font-sans text-lg font-semibold text-[#062314] mt-3">Hardware LAN Engine</h3>
          <p class="font-sans text-sm text-[#35433a] mt-2 leading-relaxed">
            All audio capture, Opus 48kHz compression, monotonic time scheduling, and packet dispatch occur directly in the host phone’s memory space.
          </p>
        </div>
        <div class="mt-6 border-t border-[#e0e2d3] pt-3 font-mono text-[11px] text-[#626b60]">
          Zero external servers involved.
        </div>
      </div>

      <!-- Card 2: No Telemetry -->
      <div class="fcard p-6 bg-white flex flex-col justify-between">
        <div>
          <div class="font-mono text-xs font-semibold text-[#118d4f] flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
            <span>02 · ZERO TELEMETRY</span>
          </div>
          <h3 class="font-sans text-lg font-semibold text-[#062314] mt-3">No Tracking Ever</h3>
          <p class="font-sans text-sm text-[#35433a] mt-2 leading-relaxed">
            RoomBeat contains zero analytics SDKs, zero crash reporters, and zero user identifiers. No IP addresses or audio metadata leave your local Wi-Fi.
          </p>
        </div>
        <div class="mt-6 border-t border-[#e0e2d3] pt-3 font-mono text-[11px] text-[#626b60]">
          0 HTTP network pings sent.
        </div>
      </div>

      <!-- Card 3: MIT License -->
      <div class="fcard p-6 bg-white flex flex-col justify-between">
        <div>
          <div class="font-mono text-xs font-semibold text-[#118d4f] flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
            <span>03 · MIT LICENSE</span>
          </div>
          <h3 class="font-sans text-lg font-semibold text-[#062314] mt-3">Permissive &amp; Auditable</h3>
          <p class="font-sans text-sm text-[#35433a] mt-2 leading-relaxed">
            The entire Android client, NDK C++ audio engine, and protocol specification are published openly on GitHub under the MIT License.
          </p>
        </div>
        <div class="mt-6 border-t border-[#e0e2d3] pt-3 font-mono text-[11px] text-[#626b60]">
          Free software forever.
        </div>
      </div>

      <!-- Card 4: Offline First -->
      <div class="fcard p-6 bg-white flex flex-col justify-between">
        <div>
          <div class="font-mono text-xs font-semibold text-[#118d4f] flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
            <span>04 · OFFLINE FIRST</span>
          </div>
          <h3 class="font-sans text-lg font-semibold text-[#062314] mt-3">Hotspot &amp; Airplane Mode</h3>
          <p class="font-sans text-sm text-[#35433a] mt-2 leading-relaxed">
            Turn on one phone’s portable hotspot and connect peers without cellular data or an internet router. Operates flawlessly off-grid.
          </p>
        </div>
        <div class="mt-6 border-t border-[#e0e2d3] pt-3 font-mono text-[11px] text-[#626b60]">
          Campsite &amp; road-trip tested.
        </div>
      </div>
    </div>
  </div>
</section>
