---
---

<section id="compare" class="border-b border-[#e0e2d3] bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Header (Graphify Side by Side) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-10 border-b border-[#e0e2d3]">
      <div class="max-w-2xl">
        <div class="op-eyebrow">
          <span class="h-1.5 w-1.5 rounded-full bg-[#118d4f]"></span>
          <span>Side by side</span>
        </div>
        <h2 class="op-title mt-3 text-3xl font-normal tracking-tight text-[#062314] sm:text-4xl md:text-5xl">
          Acoustic sync, cloud delay, or walled gardens.
        </h2>
        <p class="op-sub mt-4 text-[#35433a]">
          Five multi-speaker audio tools people consider. Here’s what each architecture actually delivers.
        </p>
      </div>

      <a
        href="https://github.com/WantedChip/RoomBeat"
        target="_blank"
        rel="noopener noreferrer"
        class="pill ghost font-mono text-sm border border-[#e0e2d3] self-start md:self-auto"
      >
        <span>View MIT Codebase</span>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Responsive Comparison Table (Graphify style) -->
    <div class="mt-10 overflow-x-auto rounded-[4px] border border-[#e0e2d3] bg-white shadow-sm">
      <table class="w-full text-left border-collapse min-w-[760px]">
        <thead>
          <tr class="border-b border-[#e0e2d3] bg-[#fbfbf7] font-mono text-xs">
            <th class="py-4 px-5 text-[#626b60] font-semibold w-1/4">CAPABILITY / SPEC</th>
            <th class="py-4 px-5 text-[#062314] font-bold bg-[#edf8f2] border-x border-[#118d4f]/30 w-1/5">
              <div class="flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-[#118d4f]"></span>
                <span>ROOMBEAT</span>
              </div>
            </th>
            <th class="py-4 px-4 text-[#626b60] font-semibold w-1/6">AmpMe</th>
            <th class="py-4 px-4 text-[#626b60] font-semibold w-1/6">SoundSeeder</th>
            <th class="py-4 px-4 text-[#626b60] font-semibold w-1/6">AirPlay 2 / Cast</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#e0e2d3] font-sans text-sm">
          <!-- Row 1: Architecture -->
          <tr class="hover:bg-[#fbfbf7]/50 transition-colors">
            <td class="py-3.5 px-5 font-mono text-xs font-medium text-[#062314]">
              Network Transport
            </td>
            <td class="py-3.5 px-5 font-medium text-[#062314] bg-[#edf8f2]/40 border-x border-[#118d4f]/30">
              <span class="font-mono text-xs text-[#118d4f] font-bold">Hardware UDP Multicast</span>
              <div class="text-xs text-[#626b60]">Zero cloud roundtrips</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Cloud WebSocket Relay
              <div class="text-xs text-[#a03d2b]">Routes via remote servers</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Unicast TCP
              <div class="text-xs text-[#626b60]">Host CPU duplicates streams</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Proprietary Cloud / RTSP
              <div class="text-xs text-[#626b60]">Walled vendor ecosystem</div>
            </td>
          </tr>

          <!-- Row 2: Latency & Drift -->
          <tr class="hover:bg-[#fbfbf7]/50 transition-colors">
            <td class="py-3.5 px-5 font-mono text-xs font-medium text-[#062314]">
              Acoustic Phase Alignment
            </td>
            <td class="py-3.5 px-5 font-medium text-[#062314] bg-[#edf8f2]/40 border-x border-[#118d4f]/30">
              <span class="font-mono text-xs text-[#118d4f] font-bold">&lt; 5 ms drift</span>
              <div class="text-xs text-[#118d4f]">Inaudible comb filtering</div>
            </td>
            <td class="py-3.5 px-4 text-[#a03d2b]">
              150–450 ms
              <div class="text-xs text-[#a03d2b]">Audible stadium flanging</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              40–120 ms
              <div class="text-xs text-[#626b60]">Uncorrected clock skew</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              ~15–50 ms
              <div class="text-xs text-[#626b60]">High latency buffer (2s)</div>
            </td>
          </tr>

          <!-- Row 3: Pricing -->
          <tr class="hover:bg-[#fbfbf7]/50 transition-colors">
            <td class="py-3.5 px-5 font-mono text-xs font-medium text-[#062314]">
              Pricing &amp; Cost
            </td>
            <td class="py-3.5 px-5 font-medium text-[#062314] bg-[#edf8f2]/40 border-x border-[#118d4f]/30">
              <span class="font-mono text-xs text-[#118d4f] font-bold">$0 / MIT Free Software</span>
              <div class="text-xs text-[#626b60]">No in-app purchases ever</div>
            </td>
            <td class="py-3.5 px-4 text-[#a03d2b]">
              $9.99 / month
              <div class="text-xs text-[#a03d2b]">$119.99/year predatory paywall</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Freemium (Abandoned)
              <div class="text-xs text-[#626b60]">No updates since 2019</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              $150+ Hardware Lock-in
              <div class="text-xs text-[#626b60]">Must buy Apple/Nest devices</div>
            </td>
          </tr>

          <!-- Row 4: Privacy & Telemetry -->
          <tr class="hover:bg-[#fbfbf7]/50 transition-colors">
            <td class="py-3.5 px-5 font-mono text-xs font-medium text-[#062314]">
              Data Privacy &amp; Tracking
            </td>
            <td class="py-3.5 px-5 font-medium text-[#062314] bg-[#edf8f2]/40 border-x border-[#118d4f]/30">
              <span class="font-mono text-xs text-[#118d4f] font-bold">Zero Telemetry (0 pings)</span>
              <div class="text-xs text-[#626b60]">No account, no sign-in</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Heavy Tracking &amp; Ads
              <div class="text-xs text-[#a03d2b]">Ad analytics &amp; user profiling</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Google Play Services telemetry
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Account required
            </td>
          </tr>

          <!-- Row 5: Offline & Hotspot -->
          <tr class="hover:bg-[#fbfbf7]/50 transition-colors">
            <td class="py-3.5 px-5 font-mono text-xs font-medium text-[#062314]">
              Offline Hotspot Support
            </td>
            <td class="py-3.5 px-5 font-medium text-[#062314] bg-[#edf8f2]/40 border-x border-[#118d4f]/30">
              <span class="font-mono text-xs text-[#118d4f] font-bold">100% Offline Capable</span>
              <div class="text-xs text-[#626b60]">Works in airplane mode</div>
            </td>
            <td class="py-3.5 px-4 text-[#a03d2b]">
              Fails without Internet
              <div class="text-xs text-[#a03d2b]">Cannot resolve cloud handshake</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Partial hotspot support
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Requires Wi-Fi router
            </td>
          </tr>

          <!-- Row 6: Scale -->
          <tr class="hover:bg-[#fbfbf7]/50 transition-colors">
            <td class="py-3.5 px-5 font-mono text-xs font-medium text-[#062314]">
              Concurrent Connected Phones
            </td>
            <td class="py-3.5 px-5 font-medium text-[#062314] bg-[#edf8f2]/40 border-x border-[#118d4f]/30">
              <span class="font-mono text-xs text-[#118d4f] font-bold">8 to 32+ Phones</span>
              <div class="text-xs text-[#626b60]">O(1) host CPU overhead</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Cloud limited
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              4–6 Phones max
              <div class="text-xs text-[#626b60]">Host phone overheats</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Up to 6–8 devices
            </td>
          </tr>

          <!-- Row 7: Audio Sources -->
          <tr class="hover:bg-[#fbfbf7]/50 transition-colors">
            <td class="py-3.5 px-5 font-mono text-xs font-medium text-[#062314]">
              Supported Audio Sources
            </td>
            <td class="py-3.5 px-5 font-medium text-[#062314] bg-[#edf8f2]/40 border-x border-[#118d4f]/30">
              <span class="font-mono text-xs text-[#118d4f] font-bold">Any Android Audio Source</span>
              <div class="text-xs text-[#626b60]">Spotify, YouTube, VLC, FLAC</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              In-app web player only
              <div class="text-xs text-[#a03d2b]">Restricted music selection</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Local MP3 files only
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Vendor supported apps only
            </td>
          </tr>

          <!-- Row 8: License -->
          <tr class="hover:bg-[#fbfbf7]/50 transition-colors">
            <td class="py-3.5 px-5 font-mono text-xs font-medium text-[#062314]">
              License &amp; Code Access
            </td>
            <td class="py-3.5 px-5 font-medium text-[#062314] bg-[#edf8f2]/40 border-x border-[#118d4f]/30">
              <span class="font-mono text-xs text-[#118d4f] font-bold">MIT Open Source</span>
              <div class="text-xs text-[#626b60]">Yours to audit and compile</div>
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Proprietary Closed Source
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Proprietary Closed Source
            </td>
            <td class="py-3.5 px-4 text-[#626b60]">
              Proprietary Closed Source
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
